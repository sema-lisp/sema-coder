#!/usr/bin/env sema
;; ── Sema Coder — a terminal coding agent written in Sema ──
;;
;; Entry point: parse args, load config, build the agent, hand off to the
;; TUI (on a TTY), one-shot mode (-p), or the plain line REPL (piped stdin).
;; The modules live in src/ (load resolves relative to this file).
;;
;;   ./coder.sema                 ;; interactive (chmod +x, or: sema coder.sema)
;;   ./coder.sema -- -p "..."     ;; one-shot
;;   ./coder.sema -- -m <model>   ;; override model

(load "src/cli.sema")
(load "src/banner.sema")
(load "src/tui.sema") ;; brings in commands, agent, tools, mcp, session, …

(define VERSION "0.3.0")
(define structured-one-shot #f)
(define structured-started-at (time-ms))

(defun emit-structured-failure (message . context)
  (let* ((ctx (if (null? context) {} (car context)))
         (model (get ctx :model ""))
         (effort (get ctx :effort ""))
         (started-at (get ctx :started-at structured-started-at)))
    (println
      (json/encode
        (one-shot-json-payload "failed" model effort
          (get ctx :usage {}) (- (time-ms) started-at) message)))))

(try
  (begin
    (define cli (parse-cli))
    (set! structured-one-shot (and (:json cli) (:prompt cli)))
    (when (:help cli)
      (show-usage)
      (exit 0))
    (when (:version cli)
      (println f"sema-coder ${VERSION}")
      (exit 0))

    ;; not `provider`/`model` — those names would shadow the config constructors
    ;; init.sema calls on every load/hot-reload (same trap as `agent` below).
    (define llm-provider (llm/auto-configure))
    (when (nil? llm-provider)
      (let ((message f"No API key found. Set ${(string/join (provider-env-keys) " or ")}."))
        (if structured-one-shot
          (emit-structured-failure message {:model (:model cli)})
          (io/println-error f"Error: ${message}")))
      (exit 1))

    (define cfg (boot-config!)) ;; ensure + load init.sema, reconcile commands + servers
    (define cwd (sys/cwd))
    ;; Load plugins after the config is applied, before the agent is built, so a
    ;; plugin's commands / overlays / hooks / keys are live for the session.
    (for-each (lambda (e) (io/println-error f"plugin error: ${e}")) (load-plugins! cwd))
    (define cli-model (:model cli))
    (mcp-autostart!) ;; connect :autostart servers before the agent is built
    ;; not `agent` — that name would shadow the (agent {…}) builtin constructor.
    (define sema-coder-agent (create-agent cwd cli-model cfg))

    ;; One-shot mode — prose to stdout, nothing else. (The TUI path fires
    ;; :session-start from new-session!; here the non-TTY paths fire it.)
    (when (:prompt cli)
      (let* ((model (choose-model cli-model cfg))
             (effort (pick-effort "" model cfg))
             (prompt (one-shot-prompt cli))
             (started-at (time-ms)))
        (if (:json cli)
          ;; Structured mode bypasses lifecycle hooks because user hooks may
          ;; write arbitrary stdout. Machine-readable stdout must contain one
          ;; JSON document and nothing else.
          (let ((attempt
                  (try
                    {:result
                      (agent/run sema-coder-agent prompt
                        (turn-opts {:on-tool-call (lambda (event) nil)
                                    :messages '()}
                                   effort))}
                    (catch e {:error e}))))
            (if-let (result (get attempt :result nil))
              (begin
                (println
                  (json/encode
                    (one-shot-json-payload "completed" model effort
                      (:usage result) (- (time-ms) started-at)
                      (:response result))))
                (exit 0))
              (begin
                (emit-structured-failure
                  (get (:error attempt) :message (str (:error attempt)))
                  {:model model :effort effort :usage (llm/session-usage)
                   :started-at started-at})
                (exit 1))))
          (begin
            (run-hooks :session-start {:cwd cwd})
            (let ((result
                    (run-turn sema-coder-agent
                      prompt '() on-tool-call effort)))
              (println (:response result))
              (exit 0))))))

    ;; Interactive, on a TTY → the full-screen TUI.
    (when (sys/tty)
      (tui-run cwd cli-model cfg sema-coder-agent)
      (exit 0))

    ;; Not a TTY (piped/dumb terminal) → the plain line-based REPL below.
    (show-banner VERSION)
    (show-welcome cwd cli-model)
    (let ((na (mcp-needs-auth)))
      (unless (null? na)
        (show-info
          f"${(length na)} MCP server(s) need auth: ${(string/join na ", ")}")))

    (run-hooks :session-start {:cwd cwd})

    (define state
      {:messages '()
       :model cli-model
       :effort ""
       :cwd cwd
       :agent sema-coder-agent
       :config cfg})

    (defun handle-input (input)
      (cond
        ((nil? input) ;; EOF — stdin closed
          (io/println-error "")
          (show-info goodbye-line)
          (exit 0))
        ((= (string/trim input) "") nil) ;; blank line — ignore
        ((slash-command? input)
          (let ((next
                  (try
                    (dispatch-command (parse-command input) state)
                    (catch e
                      (show-error f"command failed: ${(get e :message (str e))}")
                      state))))
            (if (equal? next 'quit)
              (begin
                (show-info goodbye-line)
                (exit 0))
              (set! state next))))
        (else
          (let ((result
                  (try
                    (run-turn (:agent state)
                      (string/trim input)
                      (:messages state)
                      on-tool-call
                      (let ((c (get state :config {})))
                        (pick-effort (get state :effort "")
                          (choose-model (get state :model "") c)
                          c)))
                    (catch e
                      (show-error f"agent error: ${(get e :message (str e))}")
                      #f))))
            (when result
              (show-response (:response result))
              (set! state (assoc state :messages (:messages result))))))))

    (let loop ()
      (show-prompt)
      (handle-input (io/read-line))
      (loop)))

  (catch e
    (if structured-one-shot
      (emit-structured-failure (get e :message (str e)))
      (io/println-error f"Fatal error: ${(get e :message (str e))}"))
    (exit 1)))
