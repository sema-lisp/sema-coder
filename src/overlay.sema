;; overlay.sema — the TUI's modal overlay system: a registry of modals over an
;; overlay STACK, plus the reusable Style-B list-modal and the two built-in
;; modals (MCP management ⌃O, resume/session picker ⌃R).
;;
;; A modal is a descriptor {:kind :open :render :on-key} added with
;; register-overlay!; open-overlay! pushes a fresh state, and the dispatch
;; (overlay-rows / handle-overlay-key) looks the descriptor up by the top
;; state's :kind — so a new modal (first-party or plugin) is one register call,
;; and a child modal can push over its parent. See docs/overlay-registry-design.md.
;;
;; Reads the TUI globals (*cols*, *rows*, *agent*, …) defined in tui.sema — all
;; load units share one global env. Overlay state is a list in a one-slot array.

(load "theme.sema")
(load "text.sema")
(load "keymap.sema")
(load "mcp.sema")
(load "session.sema")

;; ── Overlay stack ────────────────────────────────────────────────
;; A stack of overlay state maps (top = active), held as a list in a one-slot
;; array. Since there is no mutable-array/pop!, a list gives push (cons) + pop
;; (cdr) for free. A child modal pushes over its parent; the last pop closes.
(define *overlay-stack* (mutable-array/new 1 '()))   ;; slot 0: (state …) top-first

(defun overlay-stack ()       (mutable-array/get *overlay-stack* 0))
(defun set-overlay-stack! (l) (mutable-array/set! *overlay-stack* 0 l))

(defun overlay-active? () (not (null? (overlay-stack))))
(defun overlay ()
  "The active (top) overlay's state map, or #f when the stack is empty."
  (let ((s (overlay-stack))) (if (null? s) #f (car s))))

(defun push-overlay! (state)
  "Open STATE as a child modal over the current one."
  (set-overlay-stack! (cons state (overlay-stack))))

(defun set-overlay! (state)
  "Replace the top overlay's state (push if the stack is empty)."
  (let ((s (overlay-stack)))
    (set-overlay-stack! (if (null? s) (list state) (cons state (cdr s))))))

(defun overlay-merge! (m) (set-overlay! (merge (overlay) m)))

(defun close-overlay! ()
  "Pop the top overlay — a child returns to its parent; the last pop closes."
  (let ((s (overlay-stack))) (unless (null? s) (set-overlay-stack! (cdr s)))))

(defun close-all-overlays! () (set-overlay-stack! '()))

;; ── Overlay registry ─────────────────────────────────────────────
;; Each modal registers a descriptor keyed by :kind. open-overlay! pushes a
;; fresh state from :open; the dispatch (overlay-rows / handle-overlay-key)
;; looks the descriptor up by the top state's :kind. Built-ins register at load
;; (below); plugins call register-overlay! after init.
(define *overlays* {})   ;; kind(keyword) → {:kind :open :render :on-key}

(defun overlay-spec (m) m)   ;; descriptor constructor (a plain map; identity for now)
(defun register-overlay! (spec) (set! *overlays* (assoc *overlays* (:kind spec) spec)))
(defun overlay-registered? (kind) (if (get *overlays* kind #f) #t #f))
(defun overlay-desc () (if (overlay) (get *overlays* (:kind (overlay)) #f) #f))

(defun open-overlay! (kind . args)
  "Push a fresh overlay of KIND (its :open builds the initial state). No-op if
   KIND isn't registered. A throwing :open (e.g. a plugin that scans files)
   surfaces as an error block instead of crashing the keypress — nothing is
   pushed."
  (let ((spec (get *overlays* kind #f)))
    (when spec
      (let ((st (try ((:open spec) args)
                     (catch e (begin
                                (add-block! {:kind :error
                                             :text f"overlay ${kind} failed to open: ${(get e :message (str e))}"})
                                #f)))))
        (when st (push-overlay! st))))))

;; ── Bordered box helpers (clip content to the inner width, ANSI-safe) ──

(defun box-row (content inner)
  (let ((c (if (> (string/width content) inner) (clip-width (term/strip content) inner) content)))
    (string/append (faint "│ ") (pad-to c inner) (faint " │"))))
(defun box-top (title bw)
  (string/append (faint "┌") (accent-dim title)
                 (faint (string/append (string/repeat "─" (max 0 (- bw 2 (string/length title)))) "┐"))))
(defun box-bot (bw) (faint (string/append "└" (string/repeat "─" (max 0 (- bw 2))) "┘")))
(defun box-sep (bw) (faint (string/append "├" (string/repeat "─" (max 0 (- bw 2))) "┤")))
;; Style-B rounded corners (the chrome the overlay registry settled on).
(defun box-round (title bw)
  (string/append (faint "╭") (accent-dim title)
                 (faint (string/append (string/repeat "─" (max 0 (- bw 2 (string/width title)))) "╮"))))
(defun box-round-bot (bw) (faint (string/append "╰" (string/repeat "─" (max 0 (- bw 2))) "╯")))

(defun window-list (lst sel maxrows)
  "A MAXROWS-long window of LST that keeps index SEL visible → {:items :start}."
  (let* ((n (length lst))
         (start (max 0 (min (max 0 (- sel (quotient maxrows 2))) (max 0 (- n maxrows))))))
    {:items (take (min maxrows (max 0 (- n start))) (drop start lst)) :start start}))

(defun center-h (row bw)
  (string/append (string/repeat " " (max 0 (quotient (- *cols* bw) 2))) row))

(defun overlay-center (base box)
  (let* ((n (length base)) (h (length box)) (top (max 0 (quotient (- n h) 2))))
    (append (take top base) box (drop (min n (+ top h)) base))))

;; ── Key predicates (shared by both modals) ──

(defun key-name= (k name) (and (equal? (:kind k) :key) (equal? (:name k) name)))
(defun key-char= (k ch)   (and (equal? (:kind k) :char) (equal? (:char k) ch)))
(defun key-ctrl= (k ch)   (and (equal? (:kind k) :ctrl) (equal? (:char k) ch)))

;; ── Layout context ───────────────────────────────────────────────
;; Passed to each overlay's :render so a render never reaches for TUI globals
;; directly (which also makes it headless-testable).
(defun overlay-layout ()
  {:cols *cols* :rows *rows* :max-width (min (max 40 (- *cols* 6)) 72)})

;; ── Reusable list modal (Style B: rounded box + ▌ gutter) ─────────
;; One scrollable, selectable list every modal can reuse. A feature supplies
;; :items + a :render-item (item selected? width → content string) and :actions
;; (footer hints); list-modal owns the chrome, the ▌ selection gutter, the
;; scroll window, and centering. Returns centered rows for the compositor.

(defun modal-cell (label meta inner)
  "Row content: LABEL on the left (clipped), META right-aligned within INNER.
   Both may be styled; widths are measured display-aware (ANSI-safe)."
  (let* ((mw     (min (string/width meta) (max 0 (- inner 4))))
         (meta2  (clip-styled meta mw))
         (labelw (max 1 (- inner mw 1))))
    (string/append (pad-to (clip-styled label labelw) labelw) " " meta2)))

(defun list-modal-footer (actions)
  (string/join
    (map (lambda (a) (let ((l (get a :label "")))
                       (if (= l "") (:key a) (string/append (:key a) " " l))))
         actions)
    " · "))

(defun list-modal (spec)
  "Render a Style-B selectable list. SPEC:
     {:title s :items (…) :sel n :layout m :render-item fn :actions (…)}.
   :render-item is (fn item selected? inner-width → content-string)."
  (let* ((layout (:layout spec))
         (bw     (get layout :max-width 58))
         (inner  (- bw 4))
         (cw     (- inner 2))                          ;; content width past the gutter
         (items  (:items spec))
         (sel    (:sel spec))
         (n      (length items))
         (title  (string/append " " (:title spec) " · " (number->string n) " "))
         (rowcap (max 3 (- (get layout :rows 24) 8)))
         (win    (window-list items sel rowcap))
         (start  (:start win))
         (ri     (:render-item spec))
         (rows   (if (= n 0)
                   (list (box-row (muted "   (empty)") inner))
                   (map-indexed
                     (lambda (i it)
                       (let ((idx (+ i start)))
                         (box-row (string/append (if (= idx sel) (accent "▌ ") "  ")
                                                 (ri it (= idx sel) cw))
                                  inner)))
                     (:items win)))))
    (map #(center-h % bw)
      (append
        (list (box-round title bw))
        rows
        (list (box-sep bw))
        (list (box-row (faint (list-modal-footer (:actions spec))) inner))
        (list (box-round-bot bw))))))

;; ── MCP management modal ─────────────────────────────────────────────────────

(defun open-mcp-modal! () (open-overlay! :mcp))   ;; back-compat alias for the ⌃O binding

(defun mcp-sel-server ()
  ;; nil (not #f) when there's no selection: when-let in the connect/disconnect
  ;; helpers treats #f as truthy on current sema and would call (:name #f).
  (let ((v (mcp-records)) (i (:sel (overlay))))
    (if (and (> (length v) 0) (< i (length v))) (nth v i) nil)))

(defun rebuild-agent-with-mcp! ()
  (set! *agent* (create-agent *cwd* *model* *config*)))

(defun mcp-status-glyph (status)
  (match status
    (:connected  (ok "●"))
    (:connecting (accent "◐"))
    (:needs-auth (warn "▲"))
    (:error      (bad "○"))
    (_           (faint "◌"))))

(defun mcp-status-label (rec)
  (match (:status rec)
    (:connected  "connected")
    (:connecting "connecting…")
    (:needs-auth "needs auth — press c to sign in")
    (:error      f"error: ${(get rec :error "")}")
    (_           "idle — press c to connect")))

(defun mcp-render-item (rec selected? inner)
  (modal-cell
    (string/append (mcp-status-glyph (:status rec)) " "
                   (if selected? (bright (:name rec)) (muted (:name rec)))
                   "  " (faint (:transport rec)))
    (muted (mcp-status-label rec))
    inner))

(defun mcp-sel-tools ()
  "Tool names of the selected server, when connected."
  (let ((srv (mcp-sel-server)))
    (if (and srv (equal? (:status srv) :connected)) (map tool/name (:tools srv)) '())))

(defun mcp-tool-item (name selected? inner)
  (modal-cell (string/append "◦ " (if selected? (bright name) (accent name))) "" inner))

(defun mcp-render (state layout)
  (if (equal? (:view state) :tools)
    (let ((srv (mcp-sel-server)))
      (list-modal {:title (string/append (if srv (:name srv) "?") " · tools")
                   :items (mcp-sel-tools) :sel (:tsel state) :layout layout
                   :render-item mcp-tool-item
                   :actions (list {:key "↑↓" :label "scroll"} {:key "esc" :label "back"})}))
    (list-modal {:title "MCP servers"
                 :items (mcp-records) :sel (:sel state) :layout layout
                 :render-item mcp-render-item
                 :actions (list {:key "↑↓" :label "move"} {:key "c" :label "connect"}
                                {:key "d" :label "disconnect"} {:key "⏎" :label "tools"}
                                {:key "e" :label "edit"} {:key "esc" :label "close"})})))

(defun mcp-connect-selected! ()
  (when-let (srv (mcp-sel-server))
    (mcp-connect! (:name srv)) (rebuild-agent-with-mcp!)))

(defun mcp-disconnect-selected! ()
  (when-let (srv (mcp-sel-server))
    (mcp-disconnect! (:name srv)) (rebuild-agent-with-mcp!)))

(defun mcp-list-key (k)
  (let ((n (length (mcp-records))))
    (cond
      ((key-name= k :up)     (overlay-merge! {:sel (max 0 (- (:sel (overlay)) 1))}))
      ((key-name= k :down)   (overlay-merge! {:sel (min (max 0 (- n 1)) (+ (:sel (overlay)) 1))}))
      ((or (key-name= k :esc) (key-ctrl= k (action-ctrl-char :mcp))) (close-overlay!))
      ((or (key-char= k "c") (key-char= k "r")) (mcp-connect-selected!))
      ((key-char= k "d")     (mcp-disconnect-selected!))
      ((or (key-char= k "t") (key-name= k :enter)) (overlay-merge! {:view :tools :tsel 0}))
      ((key-char= k "e")
        (unless (open-config!)
          (add-block! {:kind :error :text f"couldn't open an editor — edit ${(config-path)} manually"})))
      (else nil))))

(defun mcp-tools-key (k)
  (cond
    ((key-name= k :esc)  (overlay-merge! {:view :list}))
    ((key-name= k :up)   (overlay-merge! {:tsel (max 0 (- (:tsel (overlay)) 1))}))
    ((key-name= k :down) (overlay-merge! {:tsel (min (max 0 (- (length (mcp-sel-tools)) 1))
                                                     (+ (:tsel (overlay)) 1))}))
    (else nil)))

(register-overlay!
  (overlay-spec
    {:kind :mcp
     :open   (lambda (args) {:kind :mcp :view :list :sel 0 :tsel 0})
     :render mcp-render
     :on-key (lambda (state k)
               (if (equal? (:view state) :tools) (mcp-tools-key k) (mcp-list-key k)))}))

;; ── Resume modal (session history) ───────────────────────────────────────────

(defun open-resume-modal! () (open-overlay! :resume))   ;; back-compat alias for the ⌃R binding

(defun resume-sel-session ()
  ;; nil (not #f) when there's no selection: when-let in the restore/detail
  ;; helpers treats #f as truthy on current sema and would call (:id #f).
  (let ((ss (:sessions (overlay))) (i (:sel (overlay))))
    (if (and (> (length ss) 0) (< i (length ss))) (nth ss i) nil)))

(defun session-model-label (m)
  (let ((md (:model m))) (if (or (not md) (= md "")) "auto" md)))

(defun resume-render-item (m selected? inner)
  (modal-cell
    (if selected? (bright (:title m)) (muted (:title m)))
    (muted (string/append (number->string (:count m)) " msgs · " (session-model-label m)))
    inner))

(defun session-first-line (s)
  (let ((parts (filter #(not (= (string/trim %) "")) (string/split s "\n"))))
    (if (null? parts) "" (string/trim (car parts)))))

(defun msg-role-label (role)
  (match role
    ("user"      (accent "▸ you "))
    ("assistant" (ok "● sema"))
    ("tool"      (faint "   tool"))
    (_           (muted role))))

(defun msg-preview-text (m)
  (let ((role (get m :role "")) (calls (get m :tool-calls '())))
    (cond
      ((= role "tool")
        (string/append "→ " (get m :tool-name "") ": " (session-first-line (get m :content ""))))
      ((and (= role "assistant") (> (length calls) 0) (= (string/trim (get m :content "")) ""))
        (string/append "→ " (string/join (map #(get % :name "") calls) ", ")))
      (else (session-first-line (get m :content ""))))))

(defun msg-preview-row (m inner)
  (let* ((label (msg-role-label (get m :role "")))
         (avail (max 4 (- inner (string/width (term/strip label)) 1))))
    (string/append label " " (muted (clip-width (msg-preview-text m) avail)))))

(define RESUME-DETAIL-ROWS 14)   ;; visible message-preview lines in the detail view

(defun resume-detail-view (state layout)
  ;; One preview line per message, so dscroll is a direct top offset (clamped).
  ;; Not a selectable list (no gutter), so it's rendered directly, not via
  ;; list-modal — but in the same Style-B rounded chrome.
  (let* ((bw    (get layout :max-width 58))
         (inner (- bw 4))
         (msgs  (:detail state))
         (lines (map #(msg-preview-row % inner) msgs))
         (start (max 0 (min (:dscroll state) (max 0 (- (length lines) RESUME-DETAIL-ROWS)))))
         (win   (take (min RESUME-DETAIL-ROWS (max 0 (- (length lines) start))) (drop start lines)))
         (sel   (resume-sel-session)))
    (map #(center-h % bw)
      (append
        (list (box-round (string/append " " (if sel (clip-width (:title sel) 30) "session") " ") bw))
        (if (null? lines)
          (list (box-row (muted "empty session") inner))
          (map #(box-row % inner) win))
        (list (box-sep bw))
        (list (box-row (faint "↑↓ scroll · ⏎/r restore · esc back") inner))
        (list (box-round-bot bw))))))

(defun resume-render (state layout)
  (if (equal? (:view state) :detail)
    (resume-detail-view state layout)
    (list-modal {:title "Resume session"
                 :items (:sessions state) :sel (:sel state) :layout layout
                 :render-item resume-render-item
                 :actions (list {:key "↑↓" :label "move"} {:key "⏎" :label "preview"}
                                {:key "r" :label "restore"} {:key "esc" :label "close"})})))

(defun resume-open-detail! ()
  (when-let (m (resume-sel-session))
    (let ((msgs (try (:messages (load-session (:id m))) (catch e '()))))
      (overlay-merge! {:view :detail :dscroll 0 :detail msgs}))))

(defun resume-restore-selected! ()
  (when-let (m (resume-sel-session))
    (restore-session! (:id m)) (close-overlay!)))

(defun resume-list-key (k)
  (let ((n (length (:sessions (overlay)))))
    (cond
      ((key-name= k :up)   (overlay-merge! {:sel (max 0 (- (:sel (overlay)) 1))}))
      ((key-name= k :down) (overlay-merge! {:sel (min (max 0 (- n 1)) (+ (:sel (overlay)) 1))}))
      ((or (key-name= k :esc) (key-ctrl= k (action-ctrl-char :resume))) (close-overlay!))
      ((key-name= k :enter) (resume-open-detail!))
      ((key-char= k "r")    (resume-restore-selected!))
      (else nil))))

(defun resume-detail-key (k)
  (let ((maxd (max 0 (- (length (:detail (overlay))) RESUME-DETAIL-ROWS))))
    (cond
      ((key-name= k :esc)  (overlay-merge! {:view :list}))
      ((key-name= k :up)   (overlay-merge! {:dscroll (max 0 (- (:dscroll (overlay)) 1))}))
      ((key-name= k :down) (overlay-merge! {:dscroll (min maxd (+ (:dscroll (overlay)) 1))}))
      ((or (key-name= k :enter) (key-char= k "r")) (resume-restore-selected!))
      (else nil))))

(defun handle-resume-key (k)
  (if (equal? (:view (overlay)) :detail) (resume-detail-key k) (resume-list-key k)))

(register-overlay!
  (overlay-spec
    {:kind :resume
     :open   (lambda (args) {:kind :resume :view :list :sel 0 :dscroll 0 :sessions (list-sessions)})
     :render resume-render
     :on-key (lambda (state k) (handle-resume-key k))}))

;; ── Dispatch — registry lookup by the top overlay's :kind ──
;; (Replaces the old hand-written if/cond over :mcp/:resume; a new modal is a
;;  register-overlay! away, and a child modal on the stack dispatches to its own
;;  descriptor because (overlay) is the top frame.)

(defun overlay-rows ()
  (let ((spec (overlay-desc)))
    (if spec ((:render spec) (overlay) (overlay-layout)) '())))

(defun handle-overlay-key (k)
  (let ((spec (overlay-desc)))
    (when spec ((:on-key spec) (overlay) k))))
