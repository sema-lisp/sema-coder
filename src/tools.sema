;; tools.sema — LLM-callable tools for the Sema Coder agent
;;
;; Ten tools: read-file, write-file, edit-file, bash, task-output, task-list,
;; task-stop, grep, find-files, and list-dir. Every path funnels through
;; resolve-path / resolve-dir, which keep reads, writes, and searches inside the
;; workspace root (see util.sema). The search tools invoke their programs
;; argv-style — no `sh -c` — so a pattern or path can't smuggle shell syntax
;; into the command line.

(load "util.sema")
(load "text.sema")

(define MAX-READ-LINES   2000)   ;; read-file line cap
(define MAX-READ-CHARS   100000) ;; read-file character cap (bounds a few huge lines)
(define MAX-READ-BYTES   2000000) ;; read-file refuses larger files: file/read has no partial read
(define MAX-OUTPUT-LINES 500)    ;; bash output line cap
(define MAX-OUTPUT-CHARS 100000) ;; bash output character cap (~100 KB ASCII)
(define MAX-MATCH-LINES  100)    ;; grep result cap
(define MAX-FIND-LINES   200)    ;; find-files result cap
(define DEFAULT-BASH-TIMEOUT-MS 120000) ;; bash default kill-after (2 min) so a hung command can't wedge the turn
(define MAX-CAPTURE-CHARS (+ MAX-OUTPUT-CHARS 1)) ;; retain one extra char so truncate-chars can report the cut
(define BACKGROUND-TASK-LIMIT 32)
(define BACKGROUND-POLL-MS 25)
(define BACKGROUND-FINALIZE-MS 250)
(define BACKGROUND-STREAM-CHARS (quotient MAX-OUTPUT-CHARS 2))
(define BACKGROUND-STREAM-HEAD (quotient BACKGROUND-STREAM-CHARS 2))
(define BACKGROUND-STREAM-TAIL (- BACKGROUND-STREAM-CHARS BACKGROUND-STREAM-HEAD))
(define *foreground-process-handles* '())

;; Background processes belong to the Sema Coder process, not to the agent turn
;; which launched them. The native proc registry owns the OS handles; this list
;; owns user-facing metadata and bounded output. The TUI starts the monitor as a
;; sibling of all turns so cancelling one turn cannot cancel process monitoring.
(define *background-tasks* '())
(define *background-task-seq* 0)
(define *background-monitor* #f)
(define current-background-task-change (make-parameter (lambda () nil)))

(defun notify-background-task-change! ()
  "Notify the frontend without allowing a redraw failure to change process
   lifecycle results or stop the background monitor."
  (try ((current-background-task-change)) (catch e nil)))

(deftool read-file
  "Read a file and return its contents with line numbers. Always read a file before editing it. Reads up to 2000 lines from the top by default; pass offset/limit to page through a larger file."
  {:path   {:type :string  :description "Path to the file to read (relative to the workspace)"}
   :offset {:type :integer :description "1-based line to start reading from (optional; default 1)" :default 1}
   :limit  {:type :integer :description "Maximum number of lines to read (optional; default 2000)" :default 2000}}
  (lambda (path offset limit)
    (try
      (let* ((resolved (resolve-path workspace-root path))
             (size (if (file/exists? resolved) (get (file/info resolved) :size 0) -1)))
        (cond
          ((< size 0) f"Error: File not found: ${path}")
          ;; file/read loads the whole file before offset/limit apply, so a huge
          ;; file is refused up front instead of read and then truncated.
          ((> size MAX-READ-BYTES)
            f"Error: ${path} is ${size} bytes, above the ${MAX-READ-BYTES}-byte read limit. Use grep to locate what you need, or bash (head, sed -n) to read a slice.")
          (else
            (let ((text (file/read resolved)))
              (if (string/contains? text "\0")
                f"Error: ${path} is a binary file (contains NUL bytes)."
                ;; numbered-window pages the file with true line numbers; the char cap
                ;; is a backstop against a few lines too long for the line window.
                (truncate-chars (numbered-window text offset limit MAX-READ-LINES)
                                MAX-READ-CHARS))))))
      (catch e f"Error reading file ${path}: ${e}"))))

(deftool write-file
  "Create or overwrite a file. Creates parent directories automatically."
  {:path    {:type :string :description "Path to write (relative to the workspace)"}
   :content {:type :string :description "Content to write"}}
  (lambda (path content)
    (try
      (let* ((resolved (resolve-path workspace-root path))
             ;; Flag an overwrite so a blind clobber is visible (unlike edit-file,
             ;; write-file needs no prior read).
             (existed  (file/exists? resolved))
             (old-size (if existed (get (try (file/info resolved) (catch e {})) :size 0) 0)))
        (file/mkdir (path/dir resolved))
        (file/write resolved content)
        (if existed
          f"Overwrote existing ${path} (${(string/length content)} chars, was ${old-size} bytes)"
          f"Wrote ${(string/length content)} chars to ${path}"))
      (catch e f"Error writing file ${path}: ${e}"))))

(defun count-occurrences (haystack needle)
  "Count non-overlapping matches in one scan; index-of loops rescan UTF-8 prefixes."
  (- (length (string/split haystack needle)) 1))

(defun apply-edit (content old_string new_string replace-all)
  "Pure core of edit-file: {:text … :count n} on success, {:error msg} otherwise.
   Requires a unique match unless REPLACE-ALL, which replaces every occurrence."
  (if (= old_string "")
    {:error "old_string must not be empty."}
    (let ((n (count-occurrences content old_string)))
      (cond
        ((= n 0) {:error "old_string not found. Read the file first."})
        ((and (> n 1) (not replace-all))
          {:error f"old_string matches ${n} times. Add surrounding context to make it unique, or pass replace_all to replace them all."})
        (else {:text (string/replace content old_string new_string) :count n})))))

(define MAX-DIFF-LINES 60)

(defun edit-diff (content old new replace-all)
  "Unified-style lines for each replacement of OLD by NEW in CONTENT: up to two
   \"  \" context lines, the \"- \" lines OLD spans, the \"+ \" lines that
   replace them. Line-based on the spanned lines only; no LCS."
  (let* ((lines (string/split content "\n"))
         (last-line (- (length lines) 1))
         (segs (string/split content old))
         (starts (let loop ((rest segs) (pos 0) (acc '()))
                   (if (or (null? (cdr rest)) (and (not replace-all) (not (null? acc))))
                     (reverse acc)
                     (let ((o (+ pos (string/length (car rest)))))
                       (loop (cdr rest) (+ o (string/length old)) (cons o acc))))))
         (hunk (lambda (o)
                 (let* ((before (string/slice content 0 o))
                        (after  (string/slice content (+ o (string/length old)) (string/length content)))
                        (s (count-occurrences before "\n"))
                        (e (+ s (count-occurrences old "\n")))
                        (prefix (last (string/split before "\n")))
                        (suffix (first (string/split after "\n")))
                        (ctx-before (take (- s (max 0 (- s 2))) (drop (max 0 (- s 2)) lines)))
                        (ctx-after  (take (- (min last-line (+ e 2)) e) (drop (+ e 1) lines))))
                   (append
                     (map #(string/append "  " %) ctx-before)
                     (map #(string/append "- " %) (take (+ 1 (- e s)) (drop s lines)))
                     (map #(string/append "+ " %) (string/split (string/append prefix new suffix) "\n"))
                     (map #(string/append "  " %) ctx-after)))))
         (all (apply append (map hunk starts))))
    (if (> (length all) MAX-DIFF-LINES)
      (append (take MAX-DIFF-LINES all)
              (list f"… +${(- (length all) MAX-DIFF-LINES)} more lines"))
      all)))

(deftool edit-file
  "Edit a file by replacing an exact string match. You MUST read the file first. old_string must match exactly (including whitespace) and, unless replace_all is set, appear exactly once."
  {:path        {:type :string  :description "Path to edit (relative to the workspace)"}
   :old_string  {:type :string  :description "Exact string to find"}
   :new_string  {:type :string  :description "Replacement string"}
   :replace_all {:type :boolean :description "Replace every occurrence instead of requiring a unique match (optional)" :default #f}}
  (lambda (path old_string new_string replace_all)
    (try
      (let ((resolved (resolve-path workspace-root path)))
        (if (not (file/exists? resolved))
          f"Error: File not found: ${path}"
          (let* ((content (file/read resolved))
                 (r (apply-edit content old_string new_string replace_all)))
            (if (:error r)
              f"Error: ${(:error r)} (${path})"
              (begin
                (file/write resolved (:text r))
                (let ((n (:count r)))
                  (string/join
                    (cons f"Edited ${path} (${n} replacement${(if (= n 1) "" "s")})"
                          (edit-diff content old_string new_string replace_all))
                    "\n")))))))
      (catch e f"Error editing file ${path}: ${e}"))))

;; ── Shell-backed tools ───────────────────────────────────────────

(defun run-in-workspace (command)
  "Run a shell command with cwd pinned to the workspace root."
  (shell command {:cwd workspace-root}))

(defun run-argv-in-workspace (argv)
  "Run ARGV directly in the workspace, with no shell interpretation."
  (let ((args (if (vector? argv) (vector->list argv) argv)))
    (when (null? args) (error "command argv must not be empty"))
    (apply shell (append args (list {:cwd workspace-root})))))

(defun system-shell-argv (command)
  "The platform shell invocation for COMMAND, suitable for proc/spawn."
  (if (= (sys/platform) "windows")
    (list "cmd" "/C" command)
    (list "sh" "-c" command)))

(defun append-captured (acc chunk)
  "Append CHUNK while retaining at most MAX-CAPTURE-CHARS codepoints."
  (let ((room (- MAX-CAPTURE-CHARS (string/length acc))))
    (if (<= room 0)
      acc
      (string/append acc
        (string/slice chunk 0 (min room (string/length chunk)))))))

(defun terminate-proc! (handle)
  "Terminate HANDLE and arrange for it to be reaped. On Unix, cancelling an
   active proc/wait invokes Sema's process-group kill, including descendants.
   Other platforms fall back to killing the direct child."
  (if (= (sys/platform) "windows")
    (begin
      (proc/kill handle)
      (let ((waiter (async (proc/wait handle))))
        (try (await waiter) (catch wait-error nil))))
    (let ((waiter (async (proc/wait handle))))
      ;; A zero-duration timeout still drives ready work before it fires. This
      ;; lets proc/wait install its process-group cancellation hook.
      (try
        (async/timeout 0 waiter)
        (catch timeout-error
          (async/cancel waiter)
          (try (await waiter) (catch cancelled nil)))))))

(defun register-foreground-process! (handle)
  (set! *foreground-process-handles*
    (cons handle *foreground-process-handles*))
  handle)

(defun forget-foreground-process! (handle)
  (set! *foreground-process-handles*
    (filter #(not (= % handle)) *foreground-process-handles*)))

(defun stop-active-foreground-processes! ()
  "Stop foreground bash processes before their owning agent task is cancelled."
  (let ((handles *foreground-process-handles*))
    ;; Clear first so a concurrent or repeated interrupt is idempotent.
    (set! *foreground-process-handles* '())
    (for-each
      (lambda (handle)
        (try (terminate-proc! handle) (catch terminate-error nil))
        (try (proc/close handle) (catch close-error nil)))
      handles)))

;; ── Background process registry ─────────────────────────────────────────────

(defun empty-background-capture () {:head "" :tail "" :chars 0})

(defun append-background-capture (capture chunk)
  "Append CHUNK to a bounded head/tail capture while counting all characters."
  (if (= chunk "")
    capture
    (let* ((head (get capture :head ""))
           (tail (get capture :tail ""))
           (head-room (max 0 (- BACKGROUND-STREAM-HEAD (string/length head))))
           (head-n (min head-room (string/length chunk)))
           (next-head
             (string/append head (string/slice chunk 0 head-n)))
           (rest (string/slice chunk head-n (string/length chunk)))
           (next-tail-full (string/append tail rest))
           (next-tail
             (if (> (string/length next-tail-full) BACKGROUND-STREAM-TAIL)
               (string/slice next-tail-full
                 (- (string/length next-tail-full) BACKGROUND-STREAM-TAIL)
                 (string/length next-tail-full))
               next-tail-full)))
      {:head next-head
       :tail next-tail
       :chars (+ (get capture :chars 0) (string/length chunk))})))

(defun background-capture-omitted (capture)
  (max 0
    (- (get capture :chars 0)
       (string/length (get capture :head ""))
       (string/length (get capture :tail "")))))

(defun background-capture-text (capture)
  (let ((omitted (background-capture-omitted capture)))
    (if (= omitted 0)
      (string/append (get capture :head "") (get capture :tail ""))
      (string/append
        (get capture :head "")
        f"\n... ${omitted} characters omitted ...\n"
        (get capture :tail "")))))

(defun background-task-active? (task)
  (member (get task :status :unknown) (list :running :settling :stopping)))

(defun background-task-by-id (id)
  (let loop ((tasks *background-tasks*))
    (cond
      ((null? tasks) nil)
      ((= (get (car tasks) :id "") id) (car tasks))
      (else (loop (cdr tasks))))))

(defun update-background-task! (task)
  (set! *background-tasks*
    (map #(if (= (get % :id "") (:id task)) task %) *background-tasks*))
  task)

(defun next-background-task-id! ()
  (set! *background-task-seq* (+ *background-task-seq* 1))
  f"task-${*background-task-seq*}")

(defun drain-background-task (task)
  "Drain currently buffered output from TASK's process handle."
  (let* ((handle (:handle task))
         (out (proc/read-stdout handle))
         (err (proc/read-stderr handle)))
    (assoc task
      :stdout-capture
        (append-background-capture (:stdout-capture task) out)
      :stderr-capture
        (append-background-capture (:stderr-capture task) err)
      :updated-at (time-ms))))

(defun cancelled-condition? (e)
  (= (get e :type :unknown) :cancelled))

(defun wait-background-handle (handle fallback-code)
  "Wait for output-reader EOF after the shell leader exits. A command which
   starts a child with `&` can leave the pipes open after that leader exits; the
   bounded wait then cancels proc/wait, which terminates the process group."
  (let ((waiter (async (proc/wait handle))))
    (try
      {:code (async/timeout BACKGROUND-FINALIZE-MS waiter) :forced #f}
      (catch e
        (cond
          ((cancelled-condition? e) (throw e))
          ((= (get e :type :unknown) :timeout)
            (async/cancel waiter)
            (try (await waiter) (catch cancelled nil))
            {:code fallback-code :forced #t})
          (else (throw e)))))))

(defun finalize-background-task! (id)
  "Reap a process already observed as exited, flush its reader threads, and
   close the native handle. A concurrent finalizer sees the temporary busy
   handle and leaves the :settling task for the owner to finish."
  (when-let (task (background-task-by-id id))
    (when (= (:status task) :settling)
      (try
        (let* ((handle (:handle task))
               (waited (wait-background-handle handle (get task :exit-code -1)))
               (code (:code waited))
               (latest (or (background-task-by-id id) task))
               (drained
                 (if (:forced waited)
                   latest
                   (drain-background-task latest)))
               (finished (assoc drained
                           :status (if (= code 0) :completed :failed)
                           :exit-code code
                           :finished-at (time-ms)))
               (finished
                 (if (:forced waited)
                   (assoc finished :cleanup-warning
                     (if (= (sys/platform) "windows")
                       "process leader exited but output stayed open; finalization timed out"
                       "process leader exited but descendants kept output open; remaining process group stopped"))
                   finished)))
          (proc/close handle)
          (update-background-task! finished)
          (notify-background-task-change!))
        (catch e
          (if (cancelled-condition? e)
            (throw e)
            ;; Another task may own proc/wait for this handle. Leave it in
            ;; :settling so a later poll can finish or recover it.
            (unless (string/contains? (get e :message (str e)) "busy")
              (let* ((latest (or (background-task-by-id id) task))
                     (code (get latest :exit-code -1)))
                (try (proc/close (:handle latest)) (catch close-error nil))
                (update-background-task!
                  (assoc latest
                    :status (if (= code 0) :completed :failed)
                    :finished-at (time-ms)
                    :finalize-error (get e :message (str e))))
                (notify-background-task-change!)))))))))

(defun poll-background-task! (id)
  "Drain and advance one task without blocking while its process is running."
  (when-let (task (background-task-by-id id))
    (cond
      ((= (:status task) :running)
        (try
          (let* ((drained (drain-background-task task))
                 (code (proc/exit-code (:handle drained))))
            (if (number? code)
              (begin
                (update-background-task!
                  (assoc drained :status :settling :exit-code code))
                (finalize-background-task! id))
              (update-background-task! drained)))
          (catch e
            (if (cancelled-condition? e)
              (throw e)
              (begin
                (try (proc/close (:handle task)) (catch close-error nil))
                (update-background-task!
                  (assoc task :status :failed :exit-code -1
                    :finished-at (time-ms)
                    :error (get e :message (str e))))
                (notify-background-task-change!))))))
      ((= (:status task) :settling) (finalize-background-task! id))
      (else task))))

(defun poll-background-tasks! ()
  "Poll a stable id snapshot. Tasks launched during the pass remain registered
   and are picked up by the next pass."
  (for-each poll-background-task! (map :id *background-tasks*))
  *background-tasks*)

(defun background-monitor-loop ()
  (let loop ()
    (poll-background-tasks!)
    (async/sleep BACKGROUND-POLL-MS)
    (loop)))

(defun start-background-monitor! ()
  (unless (and *background-monitor* (async/pending? *background-monitor*))
    (set! *background-monitor*
      (async/spawn (lambda () (background-monitor-loop)))))
  *background-monitor*)

(defun stop-background-monitor! ()
  (when *background-monitor*
    (let ((monitor *background-monitor*))
      (async/cancel monitor)
      (try (await monitor) (catch stopped nil))))
  (set! *background-monitor* #f))

(defun drop-oldest-settled-background-task (tasks)
  (let loop ((head '()) (tail tasks))
    (cond
      ((null? tail) tasks)
      ((not (background-task-active? (car tail)))
        (append (reverse head) (cdr tail)))
      (else (loop (cons (car tail) head) (cdr tail))))))

(defun make-background-task-room! ()
  "Keep at most BACKGROUND-TASK-LIMIT records. Settled records are evicted in
   oldest-first order; live processes are never evicted."
  (poll-background-tasks!)
  (let loop ()
    (when (>= (length *background-tasks*) BACKGROUND-TASK-LIMIT)
      (let ((next (drop-oldest-settled-background-task *background-tasks*)))
        (if (= (length next) (length *background-tasks*))
          (error f"background task limit reached (${BACKGROUND-TASK-LIMIT} running)")
          (begin (set! *background-tasks* next) (loop)))))))

(defun start-background-task! (command)
  "Spawn COMMAND, close its stdin, and register it before returning."
  (make-background-task-room!)
  (let* ((handle (proc/spawn (system-shell-argv command) {:cwd workspace-root}))
         (id (next-background-task-id!))
         (now (time-ms))
         (task {:id id :handle handle :command command
                :status :running :started-at now :updated-at now
                :exit-code nil
                :stdout-capture (empty-background-capture)
                :stderr-capture (empty-background-capture)}))
    ;; Background commands are non-interactive. EOF prevents a hidden read or
    ;; confirmation prompt from holding the task open indefinitely.
    (proc/close-stdin handle)
    (set! *background-tasks* (append *background-tasks* (list task)))
    (notify-background-task-change!)
    task))

(defun background-task-summary (task)
  (let* ((out (:stdout-capture task))
         (err (:stderr-capture task))
         (end (get task :finished-at (time-ms))))
    {:task-id (:id task)
     :status (keyword->string (:status task))
     :command (:command task)
     :started-at (:started-at task)
     :updated-at (get task :updated-at (:started-at task))
     :finished-at (get task :finished-at nil)
     :elapsed-ms (max 0 (- end (:started-at task)))
     :exit-code (get task :exit-code nil)
     :stdout-chars (get out :chars 0)
     :stderr-chars (get err :chars 0)
     :stdout-truncated (> (background-capture-omitted out) 0)
     :stderr-truncated (> (background-capture-omitted err) 0)
     :error (get task :error (get task :finalize-error ""))
     :cleanup-warning (get task :cleanup-warning "")}))

(defun background-task-output-state (task)
  (merge (background-task-summary task)
    {:stdout (background-capture-text (:stdout-capture task))
     :stderr (background-capture-text (:stderr-capture task))}))

(defun background-task-summaries ()
  (map background-task-summary *background-tasks*))

(defun background-task-debug-state ()
  (poll-background-tasks!)
  {:count (length *background-tasks*)
   :limit BACKGROUND-TASK-LIMIT
   :poll-ms BACKGROUND-POLL-MS
   :finalize-ms BACKGROUND-FINALIZE-MS
   :monitor-running
     (if (and *background-monitor* (async/pending? *background-monitor*)) #t #f)
   :tasks (map background-task-output-state *background-tasks*)})

(defun active-background-task-count ()
  (length (filter background-task-active? *background-tasks*)))

(defun wait-for-background-task! (id timeout-ms)
  (let ((deadline (+ (time-ms) timeout-ms)))
    (let loop ()
      (poll-background-task! id)
      (let ((task (background-task-by-id id)))
        (cond
          ((not task) #f)
          ((not (background-task-active? task)) task)
          ((>= (time-ms) deadline) task)
          (else
            (async/sleep (min BACKGROUND-POLL-MS
                           (max 0 (- deadline (time-ms)))))
            (loop)))))))

(defun stop-background-task! (id)
  (poll-background-task! id)
  (when-let (task (background-task-by-id id))
    (cond
      ((or (= (:status task) :running) (= (:status task) :stopping))
        (let ((stopping
                (if (= (:status task) :running)
                  (assoc task :status :stopping)
                  task)))
          (update-background-task! stopping)
          ;; Drain first because group termination tombstones the native handle.
          (let ((drained
                  (try (drain-background-task stopping)
                    (catch e stopping))))
            (terminate-proc! (:handle task))
            (try (proc/close (:handle task)) (catch close-error nil))
            (let ((stopped (assoc drained :status :stopped :exit-code -1
                             :finished-at (time-ms))))
              (update-background-task! stopped)
              (notify-background-task-change!)
              stopped))))
      ((= (:status task) :settling)
        (wait-for-background-task! id 1000))
      (else task))))

(defun stop-all-background-tasks! ()
  "Stop the monitor, terminate every live process, and keep final records for
   callers that inspect shutdown state."
  (stop-background-monitor!)
  (for-each
    (lambda (id)
      (try (stop-background-task! id) (catch e nil)))
    (map :id (filter background-task-active? *background-tasks*)))
  *background-tasks*)

(defun reset-background-tasks! ()
  "Test/support reset which also prevents live child-process leaks."
  (stop-all-background-tasks!)
  (set! *background-tasks* '())
  (set! *background-task-seq* 0))

(defun run-in-workspace-timed (command timeout-ms)
  "Like run-in-workspace but kills COMMAND after TIMEOUT-MS. Spawned via proc/*
   so stdout/stderr can be drained without pipe backpressure. Capture is bounded,
   and timeout cancellation kills the process group on Unix (the direct child
   elsewhere). Returns {:stdout :stderr :exit-code :timed-out}."
  (let ((h (proc/spawn (system-shell-argv command) {:cwd workspace-root}))
        (deadline (+ (time-ms) timeout-ms)))
    (register-foreground-process! h)
    (try
      (let loop ((out "") (err ""))
        (let ((out2 (append-captured out (proc/read-stdout h)))
              (err2 (append-captured err (proc/read-stderr h)))
              (code (proc/exit-code h)))
          (cond
            (code
              (proc/wait h)   ;; let the reader threads flush the tail
              (let ((result
                      {:stdout (append-captured out2 (proc/read-stdout h))
                       :stderr (append-captured err2 (proc/read-stderr h))
                       :exit-code code :timed-out #f}))
                (forget-foreground-process! h)
                (proc/close h)
                result))
            ((>= (time-ms) deadline)
              (forget-foreground-process! h)
              (terminate-proc! h)
              (try (proc/close h) (catch close-error nil))
              {:stdout out2
               :stderr err2
               :exit-code -1 :timed-out #t})
            (else
              (async/sleep (min 15 (max 0 (- deadline (time-ms)))))
              (loop out2 err2)))))
      (catch e
        ;; Clean up ordinary failures here. User interruption calls
        ;; stop-active-foreground-processes! before cancelling the agent task,
        ;; because cancellation does not unwind this catch path.
        (forget-foreground-process! h)
        (try (terminate-proc! h) (catch terminate-error nil))
        (try (proc/close h) (catch close-error nil))
        (throw e)))))

(deftool bash
  "Run a shell command in the workspace. Foreground commands return stdout, stderr, and exit code and are killed after 120s by default. Set background=true for servers, watchers, or independent long-running commands; this returns a task id immediately. Use task-output to inspect it and task-stop to end it. Background stdin is closed. Do not background a command whose result is required before the next step."
  {:command {:type :string  :description "The shell command to run"}
   :timeout {:type :integer :description "Seconds before a foreground command is killed (optional; default 120)" :default 120}
   :background {:type :boolean :description "Run as an application-owned background task and return its task id immediately (optional; default false)" :default #f}}
  (lambda (command timeout background)
    (try
      (if background
        (json/encode-pretty
          (background-task-summary (start-background-task! command)))
        (let* ((tmo    (if (and (number? timeout) (> timeout 0)) (* timeout 1000) DEFAULT-BASH-TIMEOUT-MS))
               (result (run-in-workspace-timed command tmo))
               (out    (:stdout result))
               (err    (:stderr result))
               (code   (:exit-code result))
               (parts  (append
                         (if (= (string/trim out) "") '() (list out))
                         (if (= (string/trim err) "") '() (list f"stderr:\n${err}"))
                         (if (:timed-out result)
                           (list f"[timed out after ${(quotient tmo 1000)}s — process killed]")
                           (if (= code 0) '() (list f"Exit code: ${code}"))))))
          (if (null? parts)
            "Command completed successfully (no output)."
            (-> (string/join parts "\n")
                (truncate-chars MAX-OUTPUT-CHARS)
                (truncate-lines MAX-OUTPUT-LINES)))))
      (catch e f"Error running command: ${e}"))))

(deftool task-output
  "Read retained stdout, stderr, and status for a background bash task. Set wait=true to wait up to timeout seconds for a terminal state. A running status after the deadline is not success; poll again. Output retains a bounded head and tail and reports truncation."
  {:task_id {:type :string :description "Task id returned by bash with background=true"}
   :wait {:type :boolean :description "Wait for completion before returning (optional; default false)" :default #f}
   :timeout {:type :integer :description "Maximum seconds to wait when wait=true (optional; default 30)" :default 30}}
  (lambda (task_id wait timeout)
    (let* ((seconds (if (and (number? timeout) (> timeout 0)) timeout 30))
           (task (if wait
                   (wait-for-background-task! task_id (* seconds 1000))
                   (begin (poll-background-task! task_id)
                          (background-task-by-id task_id)))))
      (if task
        (json/encode-pretty (background-task-output-state task))
        f"Error: No background task ${task_id}"))))

(deftool task-list
  "List background bash tasks in this Sema Coder process. Use task-output for retained output and task-stop to terminate one."
  {}
  (lambda ()
    (poll-background-tasks!)
    (json/encode-pretty (background-task-summaries))))

(deftool task-stop
  "Terminate a background bash task and return its final retained output and status. On Unix, termination includes descendant processes."
  {:task_id {:type :string :description "Task id returned by bash with background=true"}}
  (lambda (task_id)
    (if-let (task (stop-background-task! task_id))
      (json/encode-pretty (background-task-output-state task))
      f"Error: No background task ${task_id}")))

(defun blankish? (s) (or (not s) (= s "")))   ;; nil, #f, or ""

(defun search-argv (tool pattern target ignore-case glob)
  "Argv for TOOL (:rg | :grep) to search PATTERN in TARGET, adding case-insensitive
   and glob filters when given. `--` keeps a pattern starting with `-` from being
   read as a flag."
  (append
    (if (equal? tool :rg)
      (append (list "rg" "--line-number" "--max-count" "10" "--no-heading")
              (if ignore-case (list "-i") '())
              (if (blankish? glob) '() (list "-g" glob)))
      (append (list "grep" "-rn" "-m" "10")
              (if ignore-case (list "-i") '())
              (if (blankish? glob) '() (list (string/append "--include=" glob)))))
    (list "--" pattern target)))

(defun search-workspace (pattern target ignore-case glob)
  "ripgrep when available, else grep -rn. Both invoked argv-style (no shell)."
  (try (apply shell (search-argv :rg   pattern target ignore-case glob))
       (catch e (apply shell (search-argv :grep pattern target ignore-case glob)))))

(deftool grep
  "Search file contents for a pattern (regex). Returns matching lines with paths and line numbers. Prefers ripgrep, falls back to grep."
  {:pattern     {:type :string  :description "Search pattern (text or regex)"}
   :path        {:type :string  :description "Directory or file to search (default: workspace root)" :default "."}
   :ignore_case {:type :boolean :description "Case-insensitive match (optional)" :default #f}
   :glob        {:type :string  :description "Only search files matching this glob, e.g. '*.rs' (optional)" :optional #t}}
  (lambda (pattern path ignore_case glob)
    (if (or (nil? pattern) (= pattern ""))
      "Error: pattern is required"
      (try
        (let* ((result (search-workspace pattern (resolve-dir workspace-root path) ignore_case glob))
               (out    (string/trim (:stdout result)))
               (err    (string/trim (:stderr result))))
          (cond
            ((not (= out "")) (truncate-chars (truncate-lines out MAX-MATCH-LINES) MAX-OUTPUT-CHARS))
            ((= err "")       "No matches found.")
            (else             f"Error searching: ${err}")))
        (catch e f"Error searching: ${e}")))))

(deftool find-files
  "Find files by glob pattern. Skips .git, node_modules, target."
  {:pattern {:type :string :description "Glob (e.g. '*.rs', 'Cargo.toml')"}
   :path    {:type :string :description "Directory to search (default: workspace root)" :default "."}}
  (lambda (pattern path)
    (if (or (nil? pattern) (= pattern ""))
      "Error: pattern is required"
      (try
        (let* ((result (shell "find" (resolve-dir workspace-root path) "-name" pattern
                              "-not" "-path" "*/.git/*"
                              "-not" "-path" "*/node_modules/*"
                              "-not" "-path" "*/target/*"))
               (out    (string/trim (:stdout result))))
          (if (= out "") "No files found." (truncate-lines out MAX-FIND-LINES)))
        (catch e f"Error finding files: ${e}")))))

(deftool list-dir
  "List directory contents with types and sizes."
  {:path {:type :string :description "Directory to list (default: workspace root)" :default "."}}
  (lambda (path)
    (try
      (let* ((result (shell "ls" "-la" (resolve-dir workspace-root path)))
             (out    (string/trim (:stdout result)))
             (err    (string/trim (:stderr result))))
        (cond
          ((not (= out "")) out)
          ((= err "")       f"Error: Directory empty or not found: ${path}")
          (else             f"Error listing directory ${path}: ${err}")))
      (catch e f"Error listing directory ${path}: ${e}"))))

;; ── Tool registry ────────────────────────────────────────────────
;; all-tools reads this registry, so no hand-synced list drifts. Built-ins
;; register once (below); tools loaded by autoload-tools! fill a
;; separate resettable layer, so re-loading a tools/ dir can't duplicate and a
;; deleted tool file drops its tool — reconcile semantics, like config commands.
;;
;; Note: tools/ files use (deftool …) + (register-tool! name). A (tool {…})
;; data-constructor (building a tool from a plain map) would let the agent forge
;; tools programmatically, but the host has no such primitive and that's the
;; Forge feature (Tier 2, deferred) — the registry itself needs none of it.

(define *builtin-tools*    '())   ;; the app's own tools; registered once at load
(define *autoloaded-tools* '())   ;; from a tools/ dir; reset before each pass

(defun upsert-tool (tools t)
  "TOOLS with T appended, replacing any existing tool of the same name — so a
   re-registration updates in place instead of duplicating."
  (append (filter (lambda (x) (not (= (tool/name x) (tool/name t)))) tools)
          (list t)))

(defun register-builtin-tool! (t) (set! *builtin-tools* (upsert-tool *builtin-tools* t)))

(defun register-tool! (t)
  "Register T into the autoloaded layer — the call a tools/*.sema file makes
   after its (deftool …). Replaces a same-named tool, so a reload won't dup."
  (set! *autoloaded-tools* (upsert-tool *autoloaded-tools* t)))

(defun reset-autoloaded-tools! () (set! *autoloaded-tools* '()))

(defun all-tools ()
  "Every registered tool: the app's built-ins plus anything autoloaded from a
   tools/ dir. Rebuild the agent (create-agent) to pick up a change."
  (append *builtin-tools* *autoloaded-tools*))

;; Derived from the tools themselves — no hand-synced list to drift.
(defun tool-names () (map tool/name (all-tools)))

(defun autoload-tools! (dir)
  "Reset the autoloaded layer and (re-)load every DIR/*.sema, each of which
   registers its tool(s) with register-tool!. A removed file drops its tool; a
   re-load replaces rather than duplicates. Returns a list of load-error strings
   (empty on success); never prints, so it's safe from the TUI file-watch. No-op
   when DIR is absent."
  (reset-autoloaded-tools!)
  (if (and dir (file/exists? dir))
    (foldl
      (lambda (errs name)
        (if (string/ends-with? name ".sema")
          (let ((err (try (begin (load (path/join dir name)) #f)
                          (catch e f"tools: ${name} failed to load: ${(get e :message (str e))}"))))
            (if err (append errs (list err)) errs))
          errs))
      '() (sort (file/list dir)))
    '()))

;; Register the built-in tools into the registry (once, at load).
(for-each register-builtin-tool!
  (list read-file write-file edit-file bash task-output task-list task-stop
        grep find-files list-dir))
