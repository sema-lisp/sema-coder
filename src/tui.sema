;; tui.sema — the full-screen (sema) coder terminal UI.
;;
;; A bespoke, hand-rendered TUI built directly on the host primitives:
;; alt-screen + cursor control (term/*), buffered raw-mode input
;; (stream/read via terminal_input.sema), terminal size + resize (sys/term-size,
;; sys/on-signal :winch), and streaming agent turns (agent/run :on-text).
;;
;; Rendering model: every frame is rebuilt as a list of exactly
;; `*rows*` strings; we diff against the previous frame and rewrite only the rows
;; that changed — so there is no full-screen clear and no flicker. All output
;; goes through one stream (stdout via `display`) so cursor moves and content
;; never interleave out of order.
;;
;; Concurrency model: an agent turn runs as an async task; agent/run's LLM and
;; tool I/O offload to the runtime pool and yield cooperatively, so a sibling
;; "pump" task keeps the UI alive for the whole turn — keys are polled
;; non-blocking (scroll, resize, and type-ahead all keep working while tokens
;; stream in) and Ctrl-C cancels the turn task cleanly via async/cancel.
;;
;; Module layout: text.sema (width-aware string helpers), keymap.sema
;; (bindings), transcript.sema (blocks → styled lines), overlay.sema (the
;; MCP + resume modals). This file owns the shared UI state, the frame/diff
;; renderer, input, the agent turn, and session persistence.

(load "commands.sema")   ;; brings in theme, config, agent, tools, display, util
(load "text.sema")
(load "keymap.sema")
(load "transcript.sema")
(load "turn.sema")
(load "selection.sema")
(load "terminal_input.sema")
(load "overlay.sema")

;; ── Terminal control as strings (emitted through one stream) ─────────────────

(define ESC "\x1b;")
(defun goto (row col) (string/append ESC "[" (number->string row) ";" (number->string col) "H"))
(define CLEAR-LINE (string/append ESC "[2K"))
(define SHOW-CURSOR (string/append ESC "[?25h" ESC "[6 q"))  ;; show + steady bar (no blink)
(define HIDE-CURSOR (string/append ESC "[?25l"))
(define RESET-CURSOR (string/append ESC "[0 q"))            ;; restore terminal default on exit

;; ── Mutable UI state ─────────────────────────────────────────────────────────

(define *rows* 24)
(define *cols* 80)
(define *cwd* ".")
(define *model* "")
(define *effort* "")        ;; /effort override; "" = config, then provider default
(define *agent* #f)
(define *config* {})
(define *messages* '())
(define *input* "")
(define *cursor* 0)         ;; caret index into *input* (codepoints)
(define *scroll* 0)         ;; lines scrolled up from the bottom (0 = follow tail)
(define *psel* 0)           ;; selected index in the slash palette
(define *busy* #f)          ;; an agent turn is in flight
(define *turn* #f)          ;; promise for the in-flight turn (#f when idle)
(define *interrupt* #f)     ;; the user asked to cancel the current turn
(define *interrupt-mode* #f) ;; :stop or :steer; ordinary queue pauses on either
(define *interrupt-turn-id* #f)
(define *active-turn-id* #f)
(define *active-turn-input* "")
(define *turn-seq* 0)
(define *turn-partial* #f)  ;; captured only by agent/run :on-partial
(define *round-text* "")    ;; streamed text in the current provider round
(define *active-tool-block-index* #f)
(define *input-queue* '())  ;; durable future submissions, oldest first
(define *queue-paused* #f)  ;; interruption requires explicit resume (except steer)
(define *queue-seq* 0)
(define *event-seq* 0)
(define *turn-events* (mutable-array/new 64))
(define *resume-queue-after-command* #f)
(define *type-buffer* "")   ;; received-but-not-yet-revealed text (typewriter)
(define *should-quit* #f)
(define *last-frame* '())   ;; previous frame's rows, for diffing
(define *config-watcher* #f)  ;; fs/watch handle on the config dir
(define *config-error* #f)    ;; string while the last reload failed (persistent banner)
(define *reload-at* 0)        ;; debounce: reload once the change settles (0 = idle)
(define *session-id* #f)      ;; current session's file id (persisted after each turn)
(define *session-created* 0)  ;; its creation timestamp (ms)
(define *persist-warned* #f)  ;; emitted at most one persist-failure warning per session
(define *selection* #f)       ;; ordered rendered-line range, only while dragging
(define *selection-drag* #f)  ;; mouse-down origin while button 0 is held
(define *click-chain* #f)     ;; same-cell click count for double/triple click
(define *copy-notice* #f)     ;; {:text :ok :until}, rendered in the status row

;; The buffered reader makes raw events cheap to frame. Drain a generously
;; bounded batch and collapse adjacent mouse moves to the newest coordinate;
;; this keeps release/keyboard ordering exact without reflowing the transcript
;; hundreds of times for coordinates that could never be painted.
(define INPUT-DRAIN-LIMIT 512)
(define current-key-poll (make-parameter terminal-input-read-key-timeout))
(define FRAME-INTERVAL-MS 16)
(define current-ui-clock (make-parameter time-ms))
(define current-turn-runner (make-parameter run-turn-streaming))
(define current-turn-pump (make-parameter (lambda (turn) (pump-input! turn))))
(define current-turn-render (make-parameter (lambda () (render!))))
(define *last-render-at* 0)
(define *frame-pending* #f)

;; ── Turn controller state + inspection ──────────────────────────────────────

(define QUEUE-LIMIT 100)
(define EVENT-LOG-LIMIT 1024)
(define EVENT-LOG-RETAIN 512)

(defun next-turn-id! ()
  (set! *turn-seq* (+ *turn-seq* 1))
  f"turn-${(sys/pid)}-${((current-ui-clock))}-${*turn-seq*}")

(defun next-queue-id! ()
  (set! *queue-seq* (+ *queue-seq* 1))
  f"queue-${(sys/pid)}-${((current-ui-clock))}-${*queue-seq*}")

(defun record-turn-event! (event fields)
  "Append one ordered controller event. Tests and plugins can inspect this log
   without scraping terminal output."
  (when (>= (mutable-array/length *turn-events*) EVENT-LOG-LIMIT)
    (let ((recent (drop (- (mutable-array/length *turn-events*) EVENT-LOG-RETAIN)
                        (turn-events))))
      (set! *turn-events* (mutable-array/new EVENT-LOG-LIMIT))
      (for-each #(mutable-array/push! *turn-events* %) recent)))
  (set! *event-seq* (+ *event-seq* 1))
  (mutable-array/push! *turn-events*
    (merge {:seq *event-seq* :at ((current-ui-clock)) :event event} fields)))

(defun normalize-turn-event (event)
  "Restore keyword-valued controller fields after their JSON representation
   has turned them into strings. Queue entry modes intentionally stay strings."
  (let* ((name (get event :event #f))
         (mode (get event :mode #f))
         (source (get event :source #f))
         (event (if (string? name) (assoc event :event (string->keyword name)) event))
         (event (if (string? mode) (assoc event :mode (string->keyword mode)) event)))
    (if (string? source) (assoc event :source (string->keyword source)) event)))

(defun turn-events () (map (lambda (e) e) *turn-events*))

(defun clear-turn-events! ()
  (set! *turn-events* (mutable-array/new 64))
  (set! *event-seq* 0))

(defun queued-messages () *input-queue*)

(defun turn-controller-state ()
  "A stable snapshot for tests, overlays, and plugins."
  (let* ((tool-block (block-at *active-tool-block-index*))
         (active-tool (when (and tool-block (= (get tool-block :kind :none) :tool)
                                       (= (get tool-block :state :none) :running))
                        {:tool (get tool-block :tool "") :arg (get tool-block :arg "")})))
    {:status (if *busy* :running :idle)
     :phase (cond (active-tool :tool) (*busy* :model) (else :idle))
     :active-turn-id *active-turn-id*
     :active-input *active-turn-input*
     :active-tool active-tool
     :interrupt-mode *interrupt-mode*
     :streamed-chars (string/length *round-text*)
     :partial-message-count
       (if (and (map? *turn-partial*) (get *turn-partial* :messages #f))
         (length (:messages *turn-partial*)) 0)
     :queue *input-queue*
     :queue-paused *queue-paused*
     :message-count (length *messages*)
     :session-id *session-id*
     :events (turn-events)}))

(defun queue-insert (queue entry)
  "Steers remain FIFO but are ordered before ordinary follow-ups."
  (if (= (:mode entry) "follow-up")
    (append queue (list entry))
    (let ((steers (filter #(= (:mode %) "steer") queue))
          (followups (filter #(= (:mode %) "follow-up") queue)))
      (append steers (list entry) followups))))

(defun enqueue-input! (text mode . rest)
  "Queue TEXT as `follow-up` or `steer`. Returns the stable entry or #f when
   the bounded queue is full. A steer records the active turn it targets."
  (if (>= (length *input-queue*) QUEUE-LIMIT)
    (begin
      (add-block! {:kind :error :text f"input queue is full (${QUEUE-LIMIT})"})
      #f)
    (let* ((target (if (null? rest) *active-turn-id* (car rest)))
           (entry {:id (next-queue-id!) :text text :mode mode
                   :target-turn-id (if (= mode "steer") target #f)
                   :queued-at ((current-ui-clock))}))
      (set! *input-queue* (queue-insert *input-queue* entry))
      (record-turn-event! :message-queued
        {:queue-id (:id entry) :mode mode :target-turn-id (:target-turn-id entry)
         :text-chars (string/length text)})
      (run-hooks :turn-queued {:entry entry})
      (persist-session!)
      entry)))

(defun remove-queued-input! (id)
  "Remove ID, returning whether the queue changed."
  (let ((before (length *input-queue*)))
    (set! *input-queue* (filter #(not (= (:id %) id)) *input-queue*))
    (let ((changed? (< (length *input-queue*) before)))
      (when changed?
        (record-turn-event! :message-removed {:queue-id id})
        (persist-session!))
      changed?)))

(defun update-queued-input! (id text)
  "Edit a queued message in place without changing its stable id or order."
  (let ((found? #f))
    (set! *input-queue*
      (map (lambda (entry)
             (if (= (:id entry) id)
               (begin (set! found? #t) (assoc entry :text text))
               entry))
           *input-queue*))
    (when found?
      (record-turn-event! :message-updated
        {:queue-id id :text-chars (string/length text)})
      (persist-session!))
    found?))

(defun take-queued-input! (pred)
  "Remove and return the first entry matching PRED."
  (let loop ((head '()) (tail *input-queue*))
    (cond
      ((null? tail) #f)
      ((pred (car tail))
        (let ((entry (car tail)))
          (set! *input-queue* (append (reverse head) (cdr tail)))
          (record-turn-event! :message-dequeued
            {:queue-id (:id entry) :mode (:mode entry)
             :target-turn-id (get entry :target-turn-id #f)})
          (persist-session!)
          entry))
      (else (loop (cons (car tail) head) (cdr tail))))))

(defun dequeue-input! () (take-queued-input! (lambda (entry) #t)))

(defun take-steer-for! (turn-id)
  (take-queued-input!
    #(and (= (:mode %) "steer") (= (get % :target-turn-id #f) turn-id))))

(defun clear-input-queue! ()
  (when (or (> (length *input-queue*) 0) *queue-paused*)
    (set! *input-queue* '())
    (set! *queue-paused* #f)
    (record-turn-event! :queue-cleared {})
    (persist-session!)))

;; ── Palette (slash popup: command names, then argument completions) ──────────
;; "/mod"        → command mode: fuzzy over registered command names.
;; "/model opu"  → argument mode (when the command registered completions):
;;                 fuzzy over its entries, shown as "Provider: Model Name".

(defun palette-open? () (string/starts-with? *input* "/"))

(defun palette-query ()
  (let* ((rest (string/slice *input* 1 (string/length *input*)))
         (sp   (string/index-of rest " ")))
    (if sp (string/slice rest 0 sp) rest)))

(defun all-command-entries ()
  "Every command as {:name :desc}, in registration order. Config-declared
   commands are already in the registry (reconciled at boot/reload)."
  (map (lambda (n) {:name n :desc (get (get *commands* n {}) :desc "")}) *command-order*))

(defun fuzzy-score (query item)
  "Subsequence score (case-insensitive); #f if QUERY isn't a subsequence of ITEM."
  (if (= query "") 0
    (let ((q (string/lower query)) (it (string/lower item)))
      (let loop ((qi 0) (ii 0) (score 0) (streak 0))
        (cond
          ((>= qi (string/length q)) score)
          ((>= ii (string/length it)) #f)
          ((equal? (string/slice q qi (+ qi 1)) (string/slice it ii (+ ii 1)))
            (loop (+ qi 1) (+ ii 1) (+ score (+ 1 streak) (if (= ii 0) 3 0)) (+ streak 1)))
          (else (loop qi (+ ii 1) score 0)))))))

(defun palette-matches ()
  ;; Score every command, drop non-matches, best-first, then unwrap to entries.
  (let ((q (palette-query)))
    (->> (all-command-entries)
         (map #(list (fuzzy-score q (:name %)) %))
         (filter #(nth % 0))
         (sort-by #(- (nth % 0)))
         (map #(nth % 1)))))

(defun palette-arg-context ()
  "When the input reads \"/cmd <partial>\" and /cmd registered argument
   completions, {:cmd name :query partial}; else #f."
  (let ((sp (string/index-of *input* " ")))
    (when (and (palette-open?) sp)
      (let ((name (string/slice *input* 1 sp)))
        (when (command-has-completions? name)
          {:cmd   name
           :query (string/trim (string/slice *input* sp (string/length *input*)))})))))

(defun arg-score (q e)
  "Best fuzzy score of Q against an entry's :label or :value; #f if neither."
  (let ((a (fuzzy-score q (:label e)))
        (b (fuzzy-score q (:value e))))
    (cond ((and a b) (max a b))
          (a a)
          (else b))))

(defun arg-matches (ctx)
  (->> (command-completions (:cmd ctx) (tui-state))
       (map #(list (arg-score (:query ctx) %) %))
       (filter #(nth % 0))
       (sort-by #(- (nth % 0)))
       (map #(nth % 1))))

(defun palette-view ()
  "The open palette's contents — {:mode :commands|:args :title :entries [:ctx]}
   — or #f when the palette is closed."
  (when (palette-open?)
    (if-let (ctx (palette-arg-context))
      {:mode :args :title (:cmd ctx) :ctx ctx :entries (arg-matches ctx)}
      {:mode :commands :title "commands" :entries (palette-matches)})))

(defun palette-entries ()
  (if-let (pv (palette-view)) (:entries pv) '()))

(defun palette-choice (pv sel input)
  "The command string Enter should run for palette PV, selection SEL, and the
   raw INPUT. Pure — on-enter dispatches the result. In argument mode an
   exactly-typed value (or no match at all, e.g. a custom model id) runs as
   typed; otherwise the selection runs."
  (if (equal? (:mode pv) :args)
    (let* ((entries (:entries pv))
           (typed   (:query (:ctx pv)))
           (exact?  (any #(= (:value %) typed) entries)))
      (if (or exact? (null? entries))
        input
        f"/${(:cmd (:ctx pv))} ${(:value (nth entries (min sel (- (length entries) 1))))}"))
    (let* ((matches (:entries pv))
           (parsed  (parse-command input))
           ;; If the typed name is itself a command, run it; else run the selection.
           (known?  (get *commands* (:name parsed) #f)))
      (cond (known? input)
            ((> (length matches) 0)
             (string/append "/" (:name (nth matches (min sel (- (length matches) 1))))
                            (if (= (:args parsed) "") "" (string/append " " (:args parsed)))))
            (else input)))))

(defun palette-completion (pv sel)
  "The input Tab should complete to for PV/SEL, or #f when nothing matches."
  (let ((entries (:entries pv)))
    (when (> (length entries) 0)
      (let ((e (nth entries (min sel (- (length entries) 1)))))
        (if (equal? (:mode pv) :args)
          f"/${(:cmd (:ctx pv))} ${(:value e)}"
          (string/append "/" (:name e) " "))))))

(defun palette-limit (matches) (min 8 (length matches)))

(defun palette-row (mode e inner)
  "One palette row as plain text; palette-box styles selection afterwards.
   An :active entry (the value currently in effect) is marked with ●."
  (if (equal? mode :args)
    (let* ((mark (if (get e :active #f) " ●" ""))
           (value-width (min 24 (max 10 (quotient inner 3))))
           (label-width (max 4 (- inner value-width 1 (string/width mark)))))
      (string/append
        (string/pad-right (clip-width (:value e) value-width) value-width) " "
        (clip-width (:label e) label-width)
        mark))
    (string/append (string/pad-right (string/append "/" (:name e)) 12) " "
                   (clip-width (:desc e) (max 4 (- inner 15))))))

(defun palette-box (pv sel bw)
  "Render the palette PV as a bordered box of outer width BW: gold parens/label,
   faint borders, the selected row in accent. Returns a list of styled lines."
  (let* ((entries (:entries pv))
         (shown (take (palette-limit entries) entries))
         (inner (max 8 (- bw 4)))                 ;; text width inside │ … │
         (label f" ${(:title pv)} ")
         (top (string/append (faint "┌") (accent-dim label)
                             (faint (string/append (string/repeat "─" (max 0 (- bw 2 (string/length label)))) "┐"))))
         (bot (faint (string/append "└" (string/repeat "─" (max 0 (- bw 2))) "┘")))
         (rows (map-indexed
                 (lambda (i e)
                   (let* ((sel?  (= i sel))
                          (txt   (fit-plain (string/append (if sel? "▸ " "  ")
                                                           (palette-row (:mode pv) e (- inner 2))) inner))
                          (body  (if sel? (accent txt) (muted txt))))
                     (string/append (faint "│ ") body (faint " │"))))
                 shown)))
    (map indent (append (list top) rows (list bot)))))

;; ── Frame assembly ───────────────────────────────────────────────────────────

(define QUEUE-DISPLAY-LIMIT 3)

(defun queue-height () (min QUEUE-DISPLAY-LIMIT (length *input-queue*)))

(defun transcript-height () (max 1 (- *rows* 3 (queue-height))))

(defun queue-frame-lines ()
  "A fixed bottom region for future input. Queue contents remain separate from
   the model transcript until an entry starts."
  (map-indexed
    (lambda (i entry)
      (let* ((mode (if (= (:mode entry) "steer") "steer" "queued"))
             (label (if (= mode "steer") (warn mode) (muted mode)))
             (prefix f" ${(+ i 1)} ${label} ")
             (text (clip-width (sanitize-terminal-text (:text entry))
                               (max 4 (- *cols* (string/width prefix) 2)))))
        (string/append prefix text)))
    (take (queue-height) *input-queue*)))

(defun max-scroll ()
  "How far up the transcript can scroll before the top line is on screen."
  (max 0 (- (length (transcript-lines (- *cols* 2))) (transcript-height))))

(defun scroll-by! (n)
  "Scroll by N lines (positive = toward older), clamped to [0, max-scroll].
   Clamping on write (not just at render) keeps scroll-down responsive after
   the user over-scrolls past the top."
  (set! *scroll* (max 0 (min (+ *scroll* n) (max-scroll)))))

(defun round1 (x) (/ (round (* x 10)) 10.0))    ;; one decimal place

(defun fmt-count (n)
  ;; Bucket AFTER rounding so 999_960 reads "1.0M", not "1000.0k".
  (cond ((>= n 1000000) f"${(round1 (/ n 1000000.0))}M")
        ((>= n 1000)    (let ((k (round1 (/ n 1000.0))))
                          (if (>= k 1000) "1.0M" f"${k}k")))
        (else           (number->string n))))

(defun effective-model ()
  "The session override if set, else the config's model (so a reload shows)."
  (if (not (= *model* "")) *model* (get *config* :model "")))

(defun effective-effort ()
  "The /effort override if set, else the active model's :effort default, else
   the config's :effort (so a reload shows)."
  (pick-effort *effort* (effective-model) *config*))

(defun header-line ()
  ;; Token counts come from llm/session-usage — the cumulative sum across every
  ;; provider round (llm/last-usage would report only a turn's final round).
  (let* ((u     (llm/session-usage))
         (cost  (get u :cost-usd 0.0))
         (right (muted (string/join
                         (append
                           (list (let ((m (effective-model))) (if (= m "") "auto" m)))
                           (let ((e (effective-effort))) (if (= e "") '() (list f"effort ${e}")))
                           (list f"↑${(fmt-count (get u :prompt-tokens 0))} ↓${(fmt-count (get u :completion-tokens 0))}")
                           (if (> cost 0.0)
                             (list f"$${(/ (round (* cost 10000)) 10000.0)}")
                             '()))
                         " · ")))
         (left  (string/append " " (wordmark-with "coder")))
         (gap   (max 1 (- *cols* (string/width left) (string/width right) 1))))
    (string/append left (string/repeat " " gap) right)))

(define spinner-frames ["⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏"])
(defun spinner-frame () (nth spinner-frames (mod (quotient (time-ms) 80) 10)))

(defun active-copy-notice ()
  (when *copy-notice*
    (if (< (time-ms) (:until *copy-notice*))
      *copy-notice*
      (begin (set! *copy-notice* #f) #f))))

(defun status-line ()
  ;; A persistent config-error banner (until the next clean reload), else a
  ;; copy result, spinner while a turn runs, scroll indicator, or nothing.
  (let ((notice (active-copy-notice)))
    (indent (cond
      (*config-error* (bad "⚠ config error — using last good (fix init.sema)"))
      (notice         ((if (:ok notice) ok warn) (:text notice)))
      (*busy*         (faint (string/append (spinner-frame) " evaluating · enter queues · ctrl-enter interrupts and sends"
                                           (if (> (length *input-queue*) 0)
                                             f" · ${(length *input-queue*)} pending" ""))))
      (*queue-paused* (warn f"queue paused · ${(length *input-queue*)} pending · /queue resume"))
      ((> *scroll* 0) (faint f"↕ scrolled +${*scroll*}"))
      (else           "")))))

(defun prompt-view ()
  "Window the input so the caret is always visible (input starts at column 4).
   The window is measured in DISPLAY WIDTH — walk left from the caret until the
   caret-to-here span fills the available columns, then extend right as far as
   still fits — so `shown` never exceeds the row and wide chars can't overflow
   the fixed-row diff model."
  (let* ((avail (max 4 (- *cols* 4)))
         (len   (string/length *input*))
         (cw    #(string/width (string/slice *input* % (+ % 1))))
         (start (let loop ((i *cursor*) (w 0))
                  (if (<= i 0) 0
                    (let ((wprev (cw (- i 1))))
                      (if (> (+ w wprev) avail) i (loop (- i 1) (+ w wprev)))))))
         (end   (let loop ((i *cursor*) (w (string/width (string/slice *input* start *cursor*))))
                  (if (>= i len) len
                    (if (> (+ w (cw i)) avail) i (loop (+ i 1) (+ w (cw i))))))))
    {:text (string/slice *input* start end)
     :caret-col (min *cols* (+ 4 (string/width (string/slice *input* start *cursor*))))}))

(defun prompt-line ()
  (indent (string/append (accent (string/append prompt-glyph " ")) (:text (prompt-view)))))

(defun viewport-info (lines h)
  "Window metadata for transcript rendering and mouse-coordinate resolution."
  (let* ((n (length lines))
         (maxscroll (max 0 (- n h)))
         (sc (min *scroll* maxscroll))
         (end (- n sc))
         (start (max 0 (- end h)))
         (window (if (> n 0) (take (- end start) (drop start lines)) '()))
         (pad (- h (length window))))
    {:lines (if (> pad 0) (append (make-list pad "") window) window)
     :start start
     :pad pad}))

(defun viewport (lines h)
  "Take the last H lines, honoring *scroll* (0 = bottom). Pad with blanks on top."
  (:lines (viewport-info lines h)))

(defun current-selection ()
  "Return the selection while its rendered coordinates are still valid."
  (when *selection*
    (if (and (= (get *selection* :version -1) (transcript-version))
             (= (get *selection* :render-width -1) (- *cols* 2)))
      *selection*
      (begin (set! *selection* #f) #f))))

(defun remember-selection! (sel)
  (set! *selection*
    (assoc (assoc sel :version (transcript-version))
               :render-width (- *cols* 2))))

(defun plain-transcript-line (line)
  (term/strip (nth (transcript-lines (- *cols* 2)) line)))

(defun selected-viewport-lines (view sel)
  (map-indexed
    (lambda (row styled)
      (let ((absolute-line (+ (:start view) (- row (:pad view)))))
        (if (< absolute-line 0)
          styled
          (highlight-selection-line styled absolute-line sel))))
    (:lines view)))

(defun set-copy-notice! (text ok?)
  (set! *copy-notice* {:text text :ok ok? :until (+ (time-ms) 1800)}))

(defun copy-selection! ()
  "Copy the current selection. The gesture owner clears its visual highlight."
  (when-let (sel (current-selection))
    (let* ((styled-lines (transcript-lines (- *cols* 2)))
           ;; Only strip rows covered by the selection. Mouse movement never
           ;; calls this, and release cost scales with copied text rather than
           ;; total transcript history.
           (text (selection-text-with
                   (lambda (line) (term/strip (nth styled-lines line)))
                   sel)))
      (when (> (string/length text) 0)
        (if ((current-clipboard-copy) text)
          (set-copy-notice! f"copied ${(string/length text)} characters" #t)
          (set-copy-notice! "clipboard unavailable" #f))))))

(defun overlay-bottom (base over)
  "Replace the last (length OVER) rows of BASE with OVER."
  (let* ((n (length base)) (k (min (length over) n)))
    (append (take (- n k) base) (drop (- (length over) k) over))))

(defun build-frame ()
  ;; Content width leaves 1 char of padding on BOTH sides (indent adds the left
  ;; space; wrapping to *cols*-2 leaves the right gap) so text feels less cramped.
  (let* ((h (transcript-height))
         (view (viewport-info (transcript-lines (- *cols* 2)) h))
         (sel (current-selection))
         (tlines (if sel (selected-viewport-lines view sel) (:lines view)))
         (pv (palette-view))
         (body (if pv
                 (overlay-bottom tlines (palette-box pv *psel* (- *cols* 3)))
                 tlines))
         (rows (append (list (header-line)) body (queue-frame-lines)
                       (list (prompt-line)) (list (status-line))))
         (rows (fit-rows rows *rows*))
         (rows (if (overlay-active?) (overlay-center rows (overlay-rows)) rows))
         ;; An overlay taller than the terminal yields more than *rows* rows;
         ;; re-clamp so render! never writes past the bottom and desyncs the diff.
         (rows (fit-rows rows *rows*)))
    ;; Normalize to exactly *rows* strings of exactly *cols* columns: clip
    ;; (ANSI-safe) before padding. This is the frame invariant the diff
    ;; renderer depends on — an over-wide row soft-wraps in the terminal and
    ;; paints over the row below it, which the diff never repairs when that
    ;; row's frame content is unchanged (the painted-over-prompt bug).
    (map #(pad-to (clip-styled % *cols*) *cols*) rows)))

(defun fit-rows (rows n)
  (let ((have (length rows)))
    (cond ((= have n) rows)
          ((> have n) (take n rows))
          (else (append rows (make-list (- n have) ""))))))

;; ── Diff render ──────────────────────────────────────────────────────────────

(defun frame-ref (f i) (if (< i (length f)) (nth f i) ""))

(defun render! ()
  (let* ((frame (build-frame))
         (updates (map-indexed
                    (lambda (i new)
                      (if (equal? new (frame-ref *last-frame* i)) ""
                        (string/append (goto (+ i 1) 1) CLEAR-LINE new)))
                    frame)))
    ;; One write: the changed rows, park + show the cursor at the prompt caret
    ;; (hidden while a modal is up, since the prompt is behind it).
    (display (string/append (apply string/append updates)
                            (goto (- *rows* 1) (:caret-col (prompt-view)))
                            (if (overlay-active?) HIDE-CURSOR SHOW-CURSOR)))
    (io/flush)
    (set! *last-frame* frame)
    (set! *last-render-at* ((current-ui-clock)))
    (set! *frame-pending* #f)))

(defun full-repaint! () (set! *last-frame* '()) (render!))

(defun request-frame! () (set! *frame-pending* #t))

(defun frame-wait-ms (max-wait)
  "How long input may block without missing a pending 60 FPS frame deadline."
  (if (not *frame-pending*) max-wait
    (max 0
      (min max-wait
           (- (+ *last-render-at* FRAME-INTERVAL-MS)
              ((current-ui-clock)))))))

(defun render-pending-frame! ()
  "Render a requested frame only when its 16ms deadline is due."
  (when (and *frame-pending*
             (>= ((current-ui-clock))
                 (+ *last-render-at* FRAME-INTERVAL-MS)))
    (render!)))

;; Drain a bounded number of already-buffered events. Adjacent motion reports
;; are coalesced, but the latest move is always dispatched before a release or
;; key so drag state and event ordering remain faithful.
(defun mouse-move-event? (k)
  (and (equal? (get k :kind #f) :mouse)
       (equal? (get k :action #f) :move)))

(defun drain-input-burst! ()
  (let loop ((remaining INPUT-DRAIN-LIMIT) (handled 0) (pending-move #f))
    (if (<= remaining 0)
      (begin
        (when pending-move (handle-key pending-move))
        handled)
      (let ((k ((current-key-poll) 0)))
        (if k
          (if (mouse-move-event? k)
            (loop (- remaining 1) (+ handled 1) k)
            (begin
              (when pending-move (handle-key pending-move))
              (handle-key k)
              (loop (- remaining 1) (+ handled 1) #f)))
          (begin
            (when pending-move (handle-key pending-move))
            handled))))))

;; ── Typewriter reveal (streaming callbacks fire inside the agent task) ───────
;; Network deltas land in *type-buffer*; the pump reveals them at a steady
;; per-tick pace so display cadence is smooth regardless of burstiness, and the
;; whole transcript re-renders on the 16ms tick, not on every token.

(defun on-text-cb (delta)
  (when (> (string/length delta) 0)
    (set! *type-buffer* (string/append *type-buffer* delta))
    (set! *round-text* (string/append *round-text* delta))))

(defun on-partial-cb (partial)
  ;; Called from cancellation teardown: capture only. No render, I/O, or await.
  (set! *turn-partial* partial))

(defun reveal-tick! ()
  "Move a chunk of *type-buffer* into the streaming block. #t if it revealed.
   Reveals ~a third of the pending text (min 5 chars) so it catches up on bursts
   but types char-by-char as it drains."
  (let ((len (string/length *type-buffer*)))
    (if (= len 0) #f
      (let* ((n (min len (max 5 (quotient len 3))))
             (chunk (string/slice *type-buffer* 0 n)))
        (set! *type-buffer* (string/slice *type-buffer* n len))
        (append-assistant! chunk)
        #t))))

(defun flush-type-buffer! ()
  "Reveal everything pending at once (block boundaries, interrupts, errors)."
  (when (> (string/length *type-buffer*) 0)
    (append-assistant! *type-buffer*)
    (set! *type-buffer* "")))

(defun on-tool-cb (event)
  (flush-type-buffer!)   ;; land any pending text before the tool block / next segment
  (let (({:event evt :tool tool :args args} event))
    (cond
      ((= evt "start")
        ;; The provider round which requested this tool is complete and therefore
        ;; present in :on-partial. Text after the tool belongs to the next round.
        (set! *round-text* "")
        (let ((arg (tool-arg tool (if (map? args) args {}))))
          (set! *active-tool-block-index* (mutable-array/length (tblocks)))
          (add-block! {:kind :tool :tool tool :arg arg :state :running :ms 0})))
      ((= evt "end")
        (if *active-tool-block-index*
          (set-tool-done-at! *active-tool-block-index*
            (get event :duration-ms 0) (get event :result "") (get event :error #f))
          (set-last-tool-done!
            (get event :duration-ms 0) (get event :result "") (get event :error #f)))
        (set! *active-tool-block-index* #f)
        (add-block! {:kind :assistant :text ""}))))   ;; target for post-tool text
  ((current-turn-render)))

;; ── Running a turn ───────────────────────────────────────────────────────────
;; The turn is an async task; `pump-input!` is its sibling. The top-level
;; `await` drives both: agent/run's network rounds park on the runtime pool,
;; and every park is a chance for the pump to poll keys and repaint. Ctrl-C
;; cancels the turn task (see handle-ctrl) instead of throwing from inside a
;; streaming callback.

(defun pump-input! (turn)
  ;; Best-effort UI sibling of the turn task. Guard each pass so one bad
  ;; key/frame cannot stop updates for the rest of the turn; the turn's own
  ;; await/catch owns real errors.
  (let loop ()
    (when (or (async/pending? turn) (> (string/length *type-buffer*) 0))
      (try
        (begin
          (check-resize!)
          ;; A positive timeout parks cooperatively on Sema >=1.31, so the turn
          ;; keeps running while this task waits for input.
          (let ((k ((current-key-poll) (frame-wait-ms 16))))
            (when k
              (handle-key k)
              (drain-input-burst!)))
          (reveal-tick!)
          ;; Busy frames animate the spinner/typewriter even without input.
          ;; Continuous input updates state freely, but terminal output remains
          ;; capped at one frame per 16ms.
          (request-frame!)
          (render-pending-frame!))
        (catch e nil))
      (loop))))

(defun run-one-agent-turn! (text source)
  "Run exactly one provider turn and return {:status :turn-id}. Queue draining
   is owned by run-agent-turn!, which keeps interruption and auto-run policy in
   one place."
  (let ((turn-id (next-turn-id!))
        (prior *messages*))
  (set! *interrupt* #f)
  (set! *interrupt-mode* #f)
  (set! *interrupt-turn-id* #f)
  (set! *busy* #t)
  (set! *active-turn-id* turn-id)
  (set! *active-turn-input* text)
  (set! *turn-partial* #f)
  (set! *round-text* "")
  (set! *active-tool-block-index* #f)
  (set! *type-buffer* "")
  (record-turn-event! :turn-started
    {:turn-id turn-id :input-chars (string/length text) :source source})
  ;; The empty assistant block is the streaming target for :on-text.
  (add-block! {:kind :assistant :text ""})
  ((current-turn-render))
  (let* ((guarded-tool (lambda (event)
                         (when (= *active-turn-id* turn-id) (on-tool-cb event))))
         (guarded-text (lambda (delta)
                         (when (= *active-turn-id* turn-id) (on-text-cb delta))))
         (guarded-partial (lambda (partial)
                            (when (= *active-turn-id* turn-id) (on-partial-cb partial))))
         (turn (async ((current-turn-runner)
                       *agent* text prior guarded-tool guarded-text guarded-partial
                       (effective-effort))))
         (pump (async ((current-turn-pump) turn))))
    (set! *turn* turn)
    (let ((outcome (try {:result (await turn)} (catch e {:error e}))))
      (await pump)   ;; drain the remaining buffer at the typewriter pace
      (flush-type-buffer!)
      (set! *turn* #f)
      (set! *busy* #f)
      (let ((terminal
              (cond
                ((get outcome :result #f)
                  (let ((result (:result outcome)))
                    (set! *messages* (continued-turn-messages prior (:messages result)))
                    (record-turn-event! :turn-completed
                      {:turn-id turn-id :message-count (length *messages*)})
                    (persist-session!)
                    {:status :completed :turn-id turn-id}))
                (*interrupt*
                  (if *active-tool-block-index*
                    (cancel-running-tool-at! *active-tool-block-index*)
                    (cancel-last-running-tool!))
                  (set! *messages*
                    (interrupted-turn-messages prior text *turn-partial* *round-text* turn-id))
                  (set! *queue-paused* #t)
                  (add-block! {:kind :warn :text "turn interrupted; queued follow-ups are paused"})
                  (record-turn-event! :turn-interrupted
                    {:turn-id turn-id :mode *interrupt-mode*
                     :message-count (length *messages*)})
                  (persist-session!)
                  (run-hooks :turn-interrupted
                    {:input text :messages *messages* :turn-id turn-id})
                  {:status :interrupted :turn-id turn-id})
                (else
                  (let ((e (:error outcome)))
                    (when *active-tool-block-index*
                      (fail-running-tool-at! *active-tool-block-index*))
                    (set! *messages*
                      (failed-turn-messages prior text *turn-partial* *round-text* turn-id))
                    (add-block! {:kind :error :text (str (get e :message (str e)))})
                    (record-turn-event! :turn-failed
                      {:turn-id turn-id :error (str (get e :message (str e)))})
                    (persist-session!)
                    {:status :failed :turn-id turn-id})))))
        (set! *active-turn-id* #f)
        (set! *active-turn-input* "")
        (set! *interrupt* #f)
        (set! *interrupt-mode* #f)
        (set! *interrupt-turn-id* #f)
        (set! *active-tool-block-index* #f)
        ((current-turn-render))
        terminal)))))

(defun take-steers-for! (turn-id)
  "Take every steer accepted for TURN-ID in FIFO order. Multiple steers sent
   before cancellation acknowledgement become one replacement user turn."
  (let loop ((out '()))
    (let ((entry (take-steer-for! turn-id)))
      (if entry (loop (append out (list entry))) out))))

(defun run-agent-turn! (text . rest)
  "Run TEXT, then drain future work according to terminal status. Completed and
   failed turns auto-start the FIFO queue. Interrupted turns pause it; only the
   accepted steer(s) targeting that exact turn start immediately."
  (let loop ((input text) (source (if (null? rest) :direct (car rest))))
    (let* ((terminal (run-one-agent-turn! input source))
           (status (:status terminal))
           (next
             (if (= status :interrupted)
               (let ((steers (take-steers-for! (:turn-id terminal))))
                 (when (> (length steers) 0)
                   {:text (string/join (map :text steers) "\n\n") :source :steer}))
               (unless *queue-paused*
                 (let ((entry (dequeue-input!)))
                   (when entry
                     {:text (:text entry)
                      :source (if (= (:mode entry) "steer") :steer :queue)}))))))
      (when next (loop (:text next) (:source next))))))

(defun resume-input-queue! ()
  "Resume a queue paused by interruption and start its oldest item when idle."
  (set! *queue-paused* #f)
  (record-turn-event! :queue-resumed {})
  (persist-session!)
  (when (not *busy*)
    (let ((entry (dequeue-input!)))
      (when entry (run-agent-turn! (:text entry) :queue)))))

(defun request-queue-resume! ()
  "Defer queue execution until run-command! has applied its state map."
  (set! *resume-queue-after-command* #t))

;; ── Session persistence + restore ────────────────────────────────────────────
;; Every turn writes the whole conversation to <config>/sessions/<id>.jsonl (the
;; exact agent/run :messages shape), so /resume can reload it and continue.

(defun new-session! ()
  ;; timestamp + pid: two instances started in the same millisecond can't
  ;; silently share (and clobber) one session file.
  (set! *session-id* f"${(time-ms)}-${(sys/pid)}")
  (set! *session-created* (time-ms))
  (set! *input-queue* '())
  (set! *queue-paused* #f)
  (clear-turn-events!)
  (set! *persist-warned* #f)
  (run-hooks :session-start {:cwd *cwd*}))

(defun persist-session! ()
  (when *session-id*
    (try (save-session! *session-id* *session-created*
           (effective-model) (effective-effort) *messages*
           {:queue *input-queue* :queue-paused *queue-paused*
            :events (turn-events)})
      (catch e
        (unless *persist-warned*
          (set! *persist-warned* #t)
          (add-block! {:kind :warn :text f"session not saved: ${e} — check disk space and permissions"}))))))

(defun restore-session! (id)
  ;; The conversational state (messages/model/effort/agent) comes from the shared
  ;; session-restore-fields — the same builder the REPL /resume uses, so the two
  ;; can't drift. restore-session! then owns only the TUI-side effects: session
  ;; tracking and the transcript repaint.
  (try
    (let ((f (session-restore-fields id *cwd* *config*)))
      (set! *messages* (:messages f))
      (set! *model*    (:model f))
      (set! *effort*   (:effort f))
      (set! *agent*    (:agent f))
      (set! *session-id* id)
      (set! *session-created* (get (:meta f) :created (time-ms)))
      (set! *persist-warned* #f)
      (set! *input-queue* (get (:meta f) :queue '()))
      (set! *queue-paused* (get (:meta f) :queue-paused #f))
      (clear-turn-events!)
      (let* ((stored-events (get (:meta f) :events '()))
             (recent-events
               (drop (max 0 (- (length stored-events) EVENT-LOG-LIMIT)) stored-events)))
        (for-each (lambda (event)
                    (mutable-array/push! *turn-events* (normalize-turn-event event)))
                  recent-events))
      (let ((events (turn-events)))
        (set! *event-seq*
          (if (null? events) 0 (get (nth events (- (length events) 1)) :seq 0))))
      (clear-transcript!)
      (for-each add-block! (messages->blocks (:messages f)))
      (add-block! {:kind :info :text f"resumed “${(get (:meta f) :title id)}” · ${(length (:messages f))} messages · ${(let ((m (:model f))) (if (= m "") "auto" m))}"})
      (set! *scroll* 0))
    (catch e
      (add-block! {:kind :error :text f"failed to restore session: ${e}"}))))

;; ── Commands (dispatched through the shared registry) ────────────────────────
;; The TUI parameterizes the emit sink so registry handlers — including any
;; the user registers with register-command! — render into the transcript.

(defun tui-emit (kind text)
  (if (equal? kind :clear)
    (clear-transcript!)
    (add-block! {:kind kind :text text})))

;; ── Conversational state: the single bridge ──────────────────────
;; The app has two front-ends. The REPL (coder.sema) holds conversational state
;; as a plain `state` map and threads it through the loop. The TUI holds the same
;; six fields as working globals (*messages* *model* *effort* *cwd* *agent*
;; *config*) because its render/turn loop mutates them in place. Command handlers
;; are written ONCE against the map shape (state args → state) and run in both;
;; tui-state / apply-tui-state! are the ONLY translation between the two — every
;; command result flows through them (run-command!). Anything that restores or
;; rebuilds conversational state (e.g. /resume) goes through the shared
;; session-restore-fields so the two front-ends can't diverge.
;;
;; The six fields live in three places (this pair + coder.sema's initial map);
;; add a field to all three together.

(defun tui-state ()
  {:messages *messages* :model *model* :effort *effort*
   :cwd *cwd* :agent *agent* :config *config*})

(defun apply-tui-state! (st)
  (let ((cleared? (and (> (length *messages*) 0) (null? (:messages st)))))
    (set! *messages* (:messages st))
    (set! *model*    (:model st))
    (set! *effort*   (get st :effort ""))
    (set! *cwd*      (:cwd st))
    (set! *agent*    (:agent st))
    (set! *config*   (:config st))
    ;; A command that emptied the conversation (/clear) starts a fresh session,
    ;; so the next turn writes a new file instead of overwriting the one the
    ;; just-cleared conversation was persisted under.
    (when cleared? (new-session!))))

(defun run-command! (input)
  ;; A throwing handler (a user-registered command, or /model on a bad model)
  ;; becomes an error block instead of killing the app.
  (let ((next (try
                (parameterize ((current-emit tui-emit))
                  (dispatch-command (parse-command input) (tui-state)))
                (catch e
                  (add-block! {:kind :error :text f"command failed: ${(get e :message (str e))}"})
                  (tui-state)))))
    (if (equal? next 'quit)
      (set! *should-quit* #t)
      (begin
        (apply-tui-state! next)
        (when *resume-queue-after-command*
          (set! *resume-queue-after-command* #f)
          (resume-input-queue!))))))

;; ── Key handling ─────────────────────────────────────────────────────────────

;; ── Prompt input API ─────────────────────────────────────────────
;; The composing prompt (*input*) and caret (*cursor*, a codepoint index into
;; *input*) are read + edited only through these — the surface an overlay or
;; plugin uses to act on the prompt, e.g. a modal splicing a reference at the
;; caret. The typed-key path and the editing helpers below build on them too.

(defun prompt-text ()   *input*)
(defun prompt-cursor () *cursor*)

(defun prompt-insert! (s)
  "Insert string S into the prompt at the caret and advance the caret past it."
  (set! *input* (string/append (string/slice *input* 0 *cursor*) s
                               (string/slice *input* *cursor* (string/length *input*))))
  (set! *cursor* (+ *cursor* (string/length s)))
  (set! *psel* 0))

(defun prompt-set! (s)
  "Replace the whole prompt with S; caret to the end."
  (set! *input* s) (set! *cursor* (string/length s)) (set! *psel* 0))

(defun prompt-clear! ()
  "Empty the prompt; caret to 0."
  (set! *input* "") (set! *cursor* 0) (set! *psel* 0))

(defun backspace! ()
  (when (> *cursor* 0)
    (set! *input* (string/append (string/slice *input* 0 (- *cursor* 1))
                                 (string/slice *input* *cursor* (string/length *input*))))
    (set! *cursor* (- *cursor* 1))
    (set! *psel* 0)))

(defun forward-delete! ()
  "Delete the codepoint AT the cursor (the Delete / Fn+Delete key)."
  (when (< *cursor* (string/length *input*))
    (set! *input* (string/append (string/slice *input* 0 *cursor*)
                                 (string/slice *input* (+ *cursor* 1) (string/length *input*))))
    (set! *psel* 0)))

(defun delete-word-backward! ()
  "Delete from the previous word boundary up to the cursor (Option+Delete)."
  (let ((start (word-left-index *input* *cursor*)))
    (when (< start *cursor*)
      (set! *input* (string/append (string/slice *input* 0 start)
                                   (string/slice *input* *cursor* (string/length *input*))))
      (set! *cursor* start)
      (set! *psel* 0))))

(defun word-left! ()  (set! *cursor* (word-left-index *input* *cursor*)))
(defun word-right! () (set! *cursor* (word-right-index *input* *cursor*)))

(defun on-enter ()
  (let ((text (string/trim *input*)))
    (cond
      ((= text "") nil)
      (*busy*
        ;; Slash commands mutate local state and cannot be replayed as model
        ;; input. Keep them in the prompt until the turn becomes idle.
        (unless (palette-open?)
          (when (enqueue-input! text "follow-up")
            (prompt-clear!)
            (set! *scroll* 0))))
      ((palette-open?)
          (let ((chosen (palette-choice (palette-view) *psel* *input*)))
            ;; A :keep-input command manages the prompt itself — don't wipe it.
            (unless (command-keeps-input? (:name (parse-command chosen))) (prompt-clear!))
            (run-command! chosen)))
      (else
        (add-block! {:kind :user :text text})
        (prompt-clear!)
        (set! *scroll* 0)          ;; sending always returns you to the tail
        (run-agent-turn! text)))))

(defun on-steer-enter ()
  "Ctrl-Enter is the explicit interrupt-and-send action. The message is first
   stored as a steer targeted at the current turn, then that exact turn is
   cancelled. It is started only after terminal cancellation acknowledgement."
  (let ((text (string/trim *input*)))
    (cond
      ((= text "") nil)
      ((not *busy*) (on-enter))
      ((palette-open?) nil)
      (else
        (let ((target *active-turn-id*))
          (when (enqueue-input! text "steer" target)
            (prompt-clear!)
            (set! *scroll* 0)
            (request-interrupt-for! target :steer)))))))

(defun run-key-command! (action)
  "A key bound to a non-built-in action fires the like-named custom command, so
   :keys {:test \"ctrl-t\"} runs /test. Ignored mid-turn (like a typed command)."
  (when (and action (not *busy*))
    (let ((name (keyword->string action)))
      (when (get *commands* name #f)
        (run-command! (string/append "/" name))))))

(defun request-interrupt-for! (expected mode)
  "Cancel the expected active turn. The id check prevents a late input event
   from cancelling a newer turn after the previous one settled."
  (cond
    ((or (not *busy*) (not (= expected *active-turn-id*))) #f)
    ((and *interrupt* (= *interrupt-turn-id* expected))
      ;; A later interrupt-and-send may upgrade a plain stop while cancellation
      ;; is settling. Do not emit or send the same cancel twice.
      (when (= mode :steer) (set! *interrupt-mode* :steer))
      #t)
    (else
      (set! *interrupt* #t)
      (set! *interrupt-mode* mode)
      (set! *interrupt-turn-id* expected)
      (record-turn-event! :cancel-requested {:turn-id expected :mode mode})
      (when *turn* (async/cancel *turn*))
      #t)))

(defun request-interrupt! ()
  (request-interrupt-for! *active-turn-id* :stop))

(defun handle-ctrl (ch)
  (match (keymap-action (string/append "ctrl-" ch))
    (:interrupt
      (cond
        (*busy* (request-interrupt!))
        ((> (string/length *input*) 0) (prompt-clear!))
        (else (set! *should-quit* #t))))
    (:quit       (unless *busy* (set! *should-quit* #t)))
    (:palette    (set! *input* "/") (set! *cursor* 1) (set! *psel* 0))
    ;; No overlay while a turn runs: a restore/reconnect mid-turn would race the
    ;; finishing turn, which then overwrites *messages* and persists onto the
    ;; wrong session file. (Typed /mcp and /resume are already gated by on-enter.)
    (:mcp        (unless *busy* (open-mcp-modal!)))
    (:resume     (unless *busy* (open-resume-modal!)))
    (:clear-line (prompt-clear!))
    (:line-start (set! *cursor* 0))
    (:line-end   (set! *cursor* (string/length *input*)))
    (:repaint    (full-repaint!))
    (action      (run-key-command! action))))

(defun word-motion? (k)
  "A held Option (alt) or Ctrl modifier turns arrow motion into word motion."
  (let ((mods (get k :mods '())))
    (or (member :alt mods) (member :ctrl mods))))

(defun handle-named (k)
  (match (:name k)
    (:enter     (if (member :ctrl (get k :mods '())) (on-steer-enter) (on-enter)))
    (:backspace (backspace!))
    (:delete    (forward-delete!))
    (:left      (if (word-motion? k) (word-left!)  (set! *cursor* (max 0 (- *cursor* 1)))))
    (:right     (if (word-motion? k) (word-right!) (set! *cursor* (min (string/length *input*) (+ *cursor* 1)))))
    (:home      (set! *cursor* 0))
    (:end       (set! *cursor* (string/length *input*)))
    (:tab
      (when (palette-open?)
        (when-let (s (palette-completion (palette-view) *psel*))
          (set! *input* s)
          (set! *cursor* (string/length *input*))
          (set! *psel* 0))))
    (:up
      (if (palette-open?) (set! *psel* (max 0 (- *psel* 1)))
        (scroll-by! 1)))
    (:down
      (if (palette-open?)
        (set! *psel* (min (+ *psel* 1)
                          (max 0 (- (palette-limit (palette-entries)) 1))))
        (scroll-by! -1)))
    (:page-up   (scroll-by! (transcript-height)))
    (:page-down (scroll-by! (- (transcript-height))))
    (:esc
      (if (palette-open?)
        (prompt-clear!)
        (begin
          (set! *selection* #f)
          (set! *selection-drag* #f))))
    (_ nil)))

(defun mouse-shifted? (k) (member :shift (get k :mods '())))

(defun resolve-transcript-position (x y)
  "Resolve one-based screen X/Y to a rendered transcript position."
  (let* ((h (transcript-height))
         (row (- y 2))
         (styled-lines (transcript-lines (- *cols* 2)))
         (view (viewport-info styled-lines h))
         (absolute-line (+ (:start view) (- row (:pad view)))))
    (when (and (>= row 0) (< row h)
               (>= absolute-line 0) (< absolute-line (length styled-lines)))
      (let ((plain (term/strip (nth styled-lines absolute-line))))
        (let ((off (display-col->offset plain (- x 1))))
          {:line absolute-line
           :offset off
           :after (min (string/length plain) (+ off 1))})))))

(defun mouse-distance (a b c d)
  (+ (max (- a c) (- c a)) (max (- b d) (- d b))))

(defun register-click! (x y)
  "Return the 1→2→3→1 click count for rapid clicks at the same cell."
  (let* ((now (time-ms))
         (same? (and *click-chain*
                     (= x (:x *click-chain*))
                     (= y (:y *click-chain*))
                     (<= (- now (:at *click-chain*)) 300)))
         (count (if same?
                  (if (= (:count *click-chain*) 3) 1 (+ (:count *click-chain*) 1))
                  1)))
    (set! *click-chain* {:x x :y y :at now :count count})
    count))

(defun select-class-at! (p)
  (let* ((plain (plain-transcript-line (:line p)))
         (range (class-range plain (:offset p))))
    ;; Empty space to the right of a rendered line is a valid drag endpoint,
    ;; but a double-click there must not unexpectedly select the final word.
    (when (< (:offset p) (string/length plain))
      (remember-selection!
        {:start {:line (:line p) :offset (:start range)}
         :end   {:line (:line p) :offset (:end range)}})
      (copy-selection!))))

(defun select-line-at! (p)
  (let ((plain (plain-transcript-line (:line p))))
    (remember-selection!
      {:start {:line (:line p) :offset 0}
       :end   {:line (:line p) :offset (string/length plain)}})
    (copy-selection!)))

(defun handle-mouse (k)
  ;; Shift is the escape hatch for the terminal's native selection behavior.
  (if (mouse-shifted? k)
    (begin
      (set! *selection* #f)
      (set! *selection-drag* #f))
    (match (:action k)
      (:wheel-up   (scroll-by! 3))
      (:wheel-down (scroll-by! -3))
      (:press
        (when (= (get k :button -1) 0)
          (when-let (p (resolve-transcript-position (:x k) (:y k)))
            (set! *selection* #f)
            (set! *copy-notice* #f)
            (set! *selection-drag*
              {:x (:x k) :y (:y k) :origin p :dragged #f
               :version (transcript-version)}))))
      (:move
        (when *selection-drag*
          (if (not (= (:version *selection-drag*) (transcript-version)))
            (begin
              (set! *selection* #f)
              (set! *selection-drag* #f))
            (when-let (p (resolve-transcript-position (:x k) (:y k)))
              (when (>= (mouse-distance (:x *selection-drag*) (:y *selection-drag*)
                                        (:x k) (:y k)) 2)
                (set! *selection-drag* (assoc *selection-drag* :dragged #t)))
              (when (:dragged *selection-drag*)
                (remember-selection!
                  (inclusive-selection (:origin *selection-drag*) p)))))))
      (:release
        (when *selection-drag*
          (let ((drag *selection-drag*)
                (p (resolve-transcript-position (:x k) (:y k))))
            (set! *selection-drag* #f)
            (if (:dragged drag)
              (begin
                (set! *click-chain* #f)
                (when p
                  (remember-selection!
                    (inclusive-selection (:origin drag) p))
                  (copy-selection!)))
              (when p
                (match (register-click! (:x k) (:y k))
                  (2 (select-class-at! p))
                  (3 (select-line-at! p))
                  (_ nil))))
            ;; Selection is gesture feedback, not persistent UI state. Copy is
            ;; complete at this point, so the next frame removes the highlight.
            (set! *selection* #f))))
      (_ nil))))

(defun handle-alt (k)
  ;; Option+Delete arrives as Alt+DEL (0x7f) → delete the word before the cursor.
  (when (= (:char k) "\u007f") (delete-word-backward!)))

(defun command-c? (k)
  "True for Command-C when a kitty-keyboard terminal forwards it to the app."
  (and (equal? (:kind k) :char)
       (equal? (string/lower (:char k)) "c")
       (member :super (get k :mods '()))))

(defun ctrl-shift-c? (k)
  "True for Ctrl-Shift-C in either legacy or kitty keyboard event shape."
  (and (or (equal? (:kind k) :ctrl)
           (member :ctrl (get k :mods '())))
       (equal? (string/lower (get k :char "")) "c")
       (member :shift (get k :mods '()))))

(defun handle-key (k)
  (cond
    ;; Ctrl-Shift-C is copy-only: never turn it into Ctrl-C/quit when there is
    ;; no active selection.
    ((ctrl-shift-c? k) (copy-selection!))
    ;; Kitty-capable terminals can report macOS Command-C as a printable "c"
    ;; carrying :super. During a drag it copies the live selection; otherwise it
    ;; keeps the existing mid-turn interrupt behavior and never inserts a stray
    ;; "c".
    ((command-c? k)
      (if (current-selection) (copy-selection!)
        (when *busy* (request-interrupt!))))
    ((overlay-active?) (handle-overlay-key k))
    (else
      (match (:kind k)
        (:ctrl  (handle-ctrl (:char k)))
        (:key   (handle-named k))
        (:alt   (handle-alt k))
        (:char  (prompt-insert! (:char k)))
        (:mouse (handle-mouse k))
        (_ nil)))))

;; ── Resize ───────────────────────────────────────────────────────────────────

(define *resize-pending* #t)

(defun recompute-size! ()
  (let ((sz (sys/term-size)))
    (when (map? sz)
      (set! *rows* (max 6 (:rows sz)))
      (set! *cols* (max 20 (:cols sz)))))
  ;; Rendered-line coordinates are not meaningful after reflow.
  (set! *selection* #f)
  (set! *selection-drag* #f)
  (set! *click-chain* #f)
  (set! *resize-pending* #f))

(defun check-resize! ()
  (sys/check-signals)
  (when *resize-pending* (recompute-size!) (full-repaint!)))

;; ── Config hot-reload (watch the dir, debounce, reconcile) ────────────────────
;; Watch the config *directory* (basename-filter init.sema) so atomic-rename
;; saves are caught cross-platform, and debounce the event burst a save fires.

(defun start-config-watch! ()
  (set! *config-watcher* (try (fs/watch (config-dir) {}) (catch e #f))))

(defun config-touched? ()
  (if (not *config-watcher*) #f
    (let ((evs (try (fs/watch-events *config-watcher*) (catch e '()))))
      (any (lambda (ev)
             (any #(string/ends-with? % "init.sema") (get ev :paths '())))
           evs))))

(defun warn-keymap-conflicts! ()
  (let ((dups (keymap-conflicts)))
    (unless (null? dups)
      (add-block! {:kind :warn
                   :text f"keymap: ${(string/join dups ", ")} bound to more than one action — first match wins"}))))

(defun reload-config! ()
  (ensure-config!)
  ;; apply-config! is the shared load+reconcile path (boot / /reload / here); it
  ;; never prints, so it's safe to call from this file-watch context where the
  ;; emit sink isn't rerouted — warnings come back as data and become blocks.
  (let ((r (apply-config! (config-path) *config*)))
    (if (:ok r)
      (let ((cfg (:ok r)))
        (set! *config-error* #f)
        (set! *config* cfg)
        (set! *agent* (create-agent *cwd* *model* cfg))
        (add-block! {:kind :ok :text f"config reloaded · model → ${(if (= (:model cfg) "") "auto" (:model cfg))}"})
        (for-each (lambda (w) (add-block! {:kind :warn :text f"config: ${w}"})) (:warnings r))
        (warn-keymap-conflicts!))
      (set! *config-error* (str (:error r)))))
  (render!))

(defun poll-config! ()
  ;; A save fires a burst (create + several modifies) and can be mid-write, so
  ;; arm a deadline on any touch and reload only once it settles.
  (when (config-touched?) (set! *reload-at* (+ (time-ms) 150)))
  (when (and (> *reload-at* 0) (>= (time-ms) *reload-at*))
    (set! *reload-at* 0)
    (reload-config!)))

;; ── Entry point ──────────────────────────────────────────────────────────────

(defun tui-run (cwd model cfg agent)
  (set! *cwd* cwd) (set! *model* model) (set! *config* cfg) (set! *agent* agent)
  (set! *tui-active* #t)
  (new-session!)
  (recompute-size!)
  (sys/on-signal :winch (lambda () (set! *resize-pending* #t)))
  ;; The guards restore raw mode, the alt screen, the cursor, and mouse reporting
  ;; on ANY exit — normal or via a thrown error — so a crash can't leave the
  ;; terminal broken. (mouse wheel scrolls the transcript → {:kind :mouse}.)
  (io/with-raw-mode
    (term/with-alt-screen
      (term/with-kitty-keys
        (term/with-mouse
          (term/set-title "(sema) coder")
          (add-block! {:kind :info :text f"(sema) coder — ${cwd} · ${(if (= model "") "auto" model)}"})
          (add-block! {:kind :info :text f"; ${(epigraph)}"})
          (warn-keymap-conflicts!)
          (let ((na (mcp-needs-auth)))
            (unless (null? na)
              (add-block! {:kind :warn :text f"${(length na)} MCP server(s) need auth: ${(string/join na ", ")} — ${(key-hint :mcp)} to sign in"})))
          (start-config-watch!)
          (full-repaint!)
          (start-terminal-input!)
          (try
            (let loop ()
              (check-resize!)
              (poll-config!)
              (let ((k ((current-key-poll) (frame-wait-ms 250))))
                (when k
                  (handle-key k)
                  ;; Decode a bulk-read burst, coalescing intermediate motion,
                  ;; then paint even if more bytes are already queued.
                  (drain-input-burst!)
                  (request-frame!)))
              (render-pending-frame!)
              ;; Expire a copy status even when no key arrives.
              (when (and *copy-notice* (>= (time-ms) (:until *copy-notice*)))
                (set! *copy-notice* #f)
                (render!))
              (unless *should-quit* (loop)))
            (catch e
              (stop-terminal-input!)
              (throw e)))
          (stop-terminal-input!)))))
  ;; Back on the main screen — a quiet sign-off in the scrollback.
  (io/println-error (faint f"   ; ${goodbye-line}"))
  (display RESET-CURSOR)
  (io/flush))
