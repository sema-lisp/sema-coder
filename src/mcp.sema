;; mcp.sema — MCP server runtime: records, sync connect, reconcile, tool-merge.
;;
;; Records are a mutable-array mutated in place and read only via the accessors
;; here, so status changes stay visible to the render/pump loop. Connect is
;; synchronous (mcp/connect blocks the scheduler); a remote/OAuth connect
;; suspends the TUI (see the modal).

(load "config.sema")

(define *mcp* (mutable-array/new 8))

;; A server that never completes the MCP handshake (wrong binary, unreachable
;; URL) must not hang boot or a reconnect. Per-server override: :connect-timeout-ms
;; in the server's opts map.
(define MCP-CONNECT-TIMEOUT-MS 15000)

(defun mcp-reset! ()
  "Close all live connections, then clear the runtime registry."
  (for-each mcp-close-record! (mcp-records))
  (set! *mcp* (mutable-array/new 8)))

(defun mcp-records () *mcp*)

(defun mcp-find (name)
  "Index of the record named NAME, or #f."
  (let ((n (mutable-array/length *mcp*)))
    (let loop ((i 0))
      (cond ((>= i n) #f)
            ((= (:name (mutable-array/get *mcp* i)) name) i)
            (else (loop (+ i 1)))))))

(defun mcp-get (name)
  (let ((i (mcp-find name))) (if i (mutable-array/get *mcp* i) #f)))

(defun mcp-set! (name f)
  "Replace the record named NAME with (f record) IN PLACE."
  (let ((i (mcp-find name)))
    (when i (mutable-array/set! *mcp* i (f (mutable-array/get *mcp* i))))))

(defun server->record (srv)
  {:name      (:name srv)
   :opts      (:opts srv)
   :autostart (:autostart srv)
   :transport (:transport srv)
   :status    :idle
   :handle    #f
   :tools     '()
   :error     #f})

(defun mcp-close-record! (rec)
  (when (:handle rec)
    (try (mcp/close (:handle rec)) (catch e nil))))

(defun mcp-same-endpoint? (rec srv)
  (and (equal? (:opts rec) (:opts srv))
       (= (:transport rec) (:transport srv))))

(defun reconcile-servers! (servers)
  "Reconcile records against the config's server list: keep existing (preserving
   a live connection only when its endpoint is unchanged), add new (idle), and
   close removed or changed connections."
  (let ((declared (map :name servers)))
    (for-each
      (lambda (rec)
        (when (and (not (member (:name rec) declared)) (:handle rec))
          (mcp-close-record! rec)))
      (mcp-records))
    (let ((next (mutable-array/new 8)))
      (for-each
        (lambda (srv)
          (let ((existing (mcp-get (:name srv))))
            (mutable-array/push! next
              (cond
                ((not existing) (server->record srv))
                ((mcp-same-endpoint? existing srv)
                  (assoc existing :autostart (:autostart srv)))
                (else
                  (mcp-close-record! existing)
                  (server->record srv))))))
        servers)
      (set! *mcp* next))))

;; ── Connect / disconnect (synchronous) ───────────────────────────

(defun auth-error? (msg)
  "Heuristic: does a failed-connect message indicate authentication is needed?"
  (let ((m (string/lower msg)))
    (or (string/contains? m "401") (string/contains? m "unauthorized")
        (string/contains? m "auth"))))

(defun mcp-connect-timed (opts)
  "mcp/connect OPTS under a deadline. Returns the handle, or raises the timeout
   condition. A connect that outlives the deadline is cancelled, and a handle it
   still returns is closed."
  (let* ((ms   (get opts :connect-timeout-ms MCP-CONNECT-TIMEOUT-MS))
         (task (async (mcp/connect (dissoc opts :connect-timeout-ms)))))
    (try
      (async/timeout ms task)
      (catch e
        (async/cancel task)
        (async (try (mcp/close (await task)) (catch late nil)))
        (if (= (get e :type :unknown) :timeout)
          (throw {:type :timeout :message f"connect timed out after ${ms} ms"})
          (throw e))))))

(defun mcp-connect! (name)
  "Connect the server NAME synchronously; update status/handle/tools in place.
   Returns the resulting status keyword."
  (let ((rec (mcp-get name)))
    (cond
      ((not rec) :no-such)
      ((and (= (:status rec) :connected) (:handle rec)) :connected)
      (else
        ;; A failed or interrupted attempt may still have left a handle on the
        ;; record. Close it before replacement so reconnect cannot orphan it.
        (mcp-close-record! rec)
        (mcp-set! name #(assoc % :status :connecting :handle #f :tools '() :error #f))
        (let* ((h #f)
               (result
                (try
                  (begin
                    (set! h (mcp-connect-timed (:opts rec)))
                    {:ok h :tools (mcp/tools->sema h)})
                  (catch e
                    (when h (try (mcp/close h) (catch close-error nil)))
                    {:err e}))))
          (if (get result :ok #f)
            (begin
              (mcp-set! name #(assoc % :status :connected
                                     :handle (:ok result)
                                     :tools (:tools result)
                                     :error #f))
              :connected)
            (let* ((errmsg (str (:err result)))
                   (status (if (auth-error? errmsg) :needs-auth :error)))
              (mcp-set! name #(assoc % :status status :handle #f :tools '() :error errmsg))
              status)))))))

(defun mcp-disconnect! (name)
  "Close the server NAME's connection and clear its tools."
  (let ((rec (mcp-get name)))
    (when (and rec (:handle rec))
      (try (mcp/close (:handle rec)) (catch e nil))))
  (mcp-set! name #(assoc % :status :idle :handle #f :tools '() :error #f)))

(defun all-mcp-tools ()
  "Every tool from currently-connected servers, flattened."
  (apply append
    (map #(if (equal? (:status %) :connected) (:tools %) '())
         (mcp-records))))

(defun mcp-tool-origins ()
  "Map of tool-name → server-name for every tool on a connected server. Tool
   values carry no back-reference to their server, so origin is recovered from
   the records that pair a server's :name with its :tools."
  (foldl (lambda (m rec)
           (if (equal? (:status rec) :connected)
             (foldl (lambda (m2 t) (assoc m2 (tool/name t) (:name rec))) m (:tools rec))
             m))
         {} (mcp-records)))

(defun mcp-autostart! ()
  "Connect every idle :autostart server. Call before entering the alt-screen so
   a first-time OAuth prompt is visible. Returns the count connected."
  (let ((n 0))
    (for-each
      (lambda (rec)
        (when (and (:autostart rec) (equal? (:status rec) :idle))
          (when (equal? (mcp-connect! (:name rec)) :connected)
            (set! n (+ n 1)))))
      (mcp-records))
    n))

(defun mcp-needs-auth ()
  "Names of servers whose last connect failed needing authentication."
  (map :name (filter #(equal? (:status %) :needs-auth) (mcp-records))))
