;; agent.sema — system prompt + agent construction for Sema Coder

(load "util.sema")
(load "tools.sema")
(load "mcp.sema")
(load "config.sema")   ;; model-effort — per-model :effort defaults
(load "hooks.sema")    ;; pre/post-turn, pre-tool-call, on-error lifecycle hooks

(define *tool-name-collisions* '())   ;; names dropped by the last agent-tools

(defun agent-tools ()
  "The agent's full tool set: the app's own tools plus every connected MCP
   server's tools. Rebuild the agent (create-agent) to pick up a change.
   A duplicate tool name keeps the first definition (built-ins, then servers in
   connection order); the dropped names land in *tool-name-collisions*."
  (let loop ((rem (append (all-tools) (all-mcp-tools))) (seen '()) (kept '()) (dropped '()))
    (if (null? rem)
      (begin
        (set! *tool-name-collisions* (reverse dropped))
        (reverse kept))
      (let ((n (tool/name (car rem))))
        (if (member n seen)
          (loop (cdr rem) seen kept (cons n dropped))
          (loop (cdr rem) (cons n seen) (cons (car rem) kept) dropped))))))

(define INSTRUCTION-FILES (list "AGENTS.md" "CLAUDE.md"))
(define INSTRUCTION-FILE-MAX-CHARS 32000)

(defun project-instructions (cwd)
  "Contents of the workspace's instruction files, each under its own heading.
   Identical files (a CLAUDE.md that only @-includes AGENTS.md is not
   identical; a copy is) appear once. Returns \"\" when none exist."
  (let loop ((names INSTRUCTION-FILES) (seen '()) (out '()))
    (if (null? names)
      (string/join (reverse out) "\n\n")
      (let* ((name (car names))
             (path (path/join cwd name))
             (text (if (file/exists? path) (try (file/read path) (catch e "")) "")))
        (if (or (= (string/trim text) "") (member text seen))
          (loop (cdr names) seen out)
          (let ((body (if (> (string/length text) INSTRUCTION-FILE-MAX-CHARS)
                        (string/append (string/slice text 0 INSTRUCTION-FILE-MAX-CHARS)
                          f"\n[truncated: ${name} is longer than ${INSTRUCTION-FILE-MAX-CHARS} characters]")
                        text)))
            (loop (cdr names) (cons text seen)
              (cons f"<project_instructions source=\"${name}\">\n${(string/trim body)}\n</project_instructions>" out))))))))

(defun build-system-prompt (cwd platform)
  (string/join
    (list
      "You are Sema Coder, a coding agent that works in the terminal — reading, writing, and editing code, running commands, and searching codebases."

      "<workflow>
- Keep going until the task is genuinely resolved. Don't stop at a plan or hand back a half-finished change; see it through and verify it.
- Read a file before editing it — never assume its contents. Locate code with grep/find-files before changing it.
- Prefer edit-file for surgical changes; use write-file only for new files or full rewrites.
- Make the minimal, focused change. Match the surrounding code's style exactly.
- Verify your work — read it back or run the tests. If something fails, fix it; after three real attempts on the same failure, stop and report what you know.
</workflow>"

      "<background_processes>
- Use bash with background=true for servers, file watchers, or independent long-running commands whose result is not needed before the next step. It returns a task id immediately.
- Use task-output to poll retained stdout, stderr, exit status, and truncation. Use task-list to recover task ids and task-stop to terminate a task.
- Background commands cannot read stdin. They survive agent-turn interruption but are stopped when Sema Coder exits.
- Keep the managed command in the foreground of its shell. Do not append `&` or use a daemon mode; background=true already provides process ownership.
- Do not claim that a background command succeeded until task-output reports a terminal status and you inspected its output.
</background_processes>"

      "<tone>
- Be concise. Default to a few lines. The user sees your diffs — don't narrate them.
- Show code, not prose about code. A change request deserves a diff — never answer one with prose alone. (Explaining or reviewing code is prose work; that's fine.)
- Prioritize truth over agreement. Disagree when the user is wrong, and say so plainly. Never open with \"You're absolutely right.\" No flattery, no hedging, no filler.
- No emoji. No time estimates (\"quick fix\"). No preamble or postamble.
</tone>"

      "<voice>
There is a little of the Lisp elder in you — sixty years of parentheses, dry and unhurried, more interested in meaning than noise. A seasoning, not a costume:
- Replies are plain and technical, start to finish. Most turns — and most whole sessions — carry no character at all.
- At most ONE aside per session, and only when a moment earns it: a real objection, a subtle bug uncovered, a naming decision that matters. A long or impressive answer does not by itself earn one — the aside is never a closing flourish, never a summary garnish. If you're unsure whether the moment qualifies, it doesn't.
- The only vehicle is a single Lisp-comment line — `; ` plus one dry sentence, placed next to the observation it belongs to, not at the end of the reply. Shaped like these (do not reuse them):
  ; the bug was in the name — it promised a list and delivered a maybe.
  ; we tried this in '86; the garbage collector won that argument too.
- Names are your one fixation: a good name is a sign that carries its meaning (sêma). When a rename settles a design argument, one line may say so.
- NEVER in code, comments, commit messages, diffs, or identifiers — those stay neutral and conventional. The voice lives in prose only.
</voice>"

      f"<environment>
Working directory: ${cwd}
Platform: ${platform}
</environment>"

      (project-instructions cwd))
    "\n\n"))

(defun choose-model (model cfg)
  "Model precedence: explicit MODEL > config :model > \"\" (auto-detect)."
  (if (not (= model "")) model (get cfg :model "")))

(defun sync-provider! (cfg model-id)
  "Point the llm default provider at the one that owns MODEL-ID per the config's
   :models groups. The agent value carries no provider — every turn uses the
   registry default — so an OpenAI id in the picker would otherwise still hit
   the boot default (Anthropic) and 404. No-op for a hand-typed id we don't know
   the provider of, or a provider that isn't configured (set-default throws)."
  (let ((p (model-provider-name cfg model-id)))
    (when p
      (try (llm/set-default p) (catch e nil)))))

(defun create-agent (cwd model cfg)
  "Build the coding agent. Model precedence: explicit arg > config > auto."
  (set-workspace-root! cwd)
  (let* ((platform f"${(sys/os)} (${(sys/arch)})")
         (chosen (choose-model model cfg))
         (prompt (build-system-prompt cwd platform)))
    (sync-provider! cfg chosen)
    ;; Anonymous constructor, not defagent — this is called on every model
    ;; switch / config reload / MCP connect, and defagent would rebind a global
    ;; each time. (agent {…}) is cheap (~1µs) and history lives in :messages.
    (agent
      {:system prompt
       :tools (agent-tools)
       :max-turns (get cfg :max-turns 50)
       :model chosen})))

(defun pick-effort (override model-id cfg)
  "Effort precedence: session OVERRIDE (/effort) → the model's own :effort in
   the config's :models entry for MODEL-ID → the config :effort. \"\" means
   the provider default."
  (let ((m-eff (model-effort cfg model-id)))
    (cond ((and override (not (= override ""))) override)
          ((not (= m-eff "")) m-eff)
          (else (get cfg :effort "")))))

(defun turn-opts (opts effort)
  "Merge a non-empty reasoning EFFORT into an agent/run OPTS map. Effort is
   portable — providers/models without it treat the option as a no-op."
  (if (and effort (not (= effort ""))) (assoc opts :reasoning-effort effort) opts))

(defun with-tool-hooks (on-tool)
  "Wrap an :on-tool-call callback so :pre-tool-call hooks fire as each tool
   starts, then delegate to the original ON-TOOL (which does the rendering)."
  (lambda (event)
    (when (= (get event :event "") "start")
      (run-hooks :pre-tool-call {:tool (get event :tool "") :args (get event :args {})}))
    (on-tool event)))

(defun run-turn (agent input messages on-tool effort)
  "Blocking turn used by the non-TTY / one-shot path (no live streaming).
   Fires pre-turn / pre-tool-call / on-error / post-turn hooks around the run."
  (run-hooks :pre-turn {:input input :messages messages})
  (let ((result
          (try (agent/run agent input
                 (turn-opts {:on-tool-call (with-tool-hooks on-tool) :messages messages} effort))
            (catch e (run-hooks :on-error {:input input :error e}) (throw e)))))
    (run-hooks :post-turn {:input input :result result :usage (:usage result)})
    result))

(defun run-turn-streaming (agent input messages on-tool on-text on-partial effort)
  "Turn used by the TUI: :on-text streams assistant deltas, :on-tool-call streams
   tool events, and :on-partial recovers completed history if the cooperative
   task fails or is cancelled. The partial callback must only capture the map;
   Sema invokes it during cancellation teardown where it cannot park."
  (run-hooks :pre-turn {:input input :messages messages})
  (let ((result
          (try (agent/run agent input
                 (turn-opts {:on-tool-call (with-tool-hooks on-tool)
                             :on-text on-text
                             :on-partial on-partial
                             :messages messages}
                            effort))
            (catch e (run-hooks :on-error {:input input :error e}) (throw e)))))
    (run-hooks :post-turn {:input input :result result :usage (:usage result)})
    result))
