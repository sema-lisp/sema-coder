;; config.sema — configuration as DATA.
;;
;; init.sema is Lisp that calls value-returning constructors (coder-config,
;; mcp-server, command, provider, model) and hands the result to
;; (configure! cfg). The loader is
;; pure: it captures that value and returns {:ok cfg} | {:error e} — it never
;; mutates the app's active config or prints, so the caller owns recovery policy
;; and reconciles runtime to the returned value (no accumulators, no reset).

;; A parameter so tests (and a future --config flag) can redirect the dir.
(define config-dir-override (make-parameter #f))
(defun config-dir ()
  (or (config-dir-override)
      (let ((e (env "SEMA_CODER_CONFIG_DIR"))) (if (and e (not (= e ""))) e #f))
      (path/join (sys/config-dir) "sema" "sema-coder")))
(defun config-path () (path/join (config-dir) "init.sema"))
;; Autoloaded first-party tools live beside init.sema (see tools.sema's
;; autoload-tools!). Project-local + tiered tool storage is the Forge concern.
(defun tools-dir () (path/join (config-dir) "tools"))

;; ── Constructors: return values, never mutate ────────────────────

(defun model (id label . opts)
  "A selectable model: ID is what the provider API accepts, LABEL is the human
   name shown by the /model autocomplete. An optional OPTS map carries
   per-model defaults — currently :effort, applied unless /effort overrides."
  (merge (if (null? opts) {} (car opts)) {:id id :label label}))

(defun provider (name models)
  "A provider group for the /model autocomplete: display NAME plus its MODELS
   (a list of (model …) records)."
  {:name name :models models})

;; ── Provider descriptor table — one source of truth ─────────────
;; Every provider fact lives here once: the llm-registry :id, the display
;; :display-name shown by the /model picker, the :env-key its API key comes
;; from, and the :models it offers. default-models, provider-env-key, the
;; generated init.sema template, and the boot "no API key" message all derive
;; from this list — so adding a provider is a one-place change.
(define provider-descriptors
  (list
    {:id "anthropic" :display-name "Anthropic" :env-key "ANTHROPIC_API_KEY"
     :models (list
               (model "claude-opus-5"    "Claude Opus 5")
               (model "claude-fable-5"   "Claude Fable 5")
               (model "claude-opus-4-8"  "Claude Opus 4.8")
               (model "claude-sonnet-5"  "Claude Sonnet 5")
               (model "claude-haiku-4-5" "Claude Haiku 4.5"))}
    {:id "openai" :display-name "OpenAI" :env-key "OPENAI_API_KEY"
     :models (list
               (model "gpt-5.6-sol"   "GPT-5.6 Sol")
               (model "gpt-5.6-terra" "GPT-5.6 Terra")
               (model "gpt-5.6-luna"  "GPT-5.6 Luna")
               (model "gpt-5.5"       "GPT-5.5"))}))

(defun provider-descriptor-by-name (name)
  "The descriptor whose :display-name matches NAME (case-insensitive), or #f."
  ;; plain filter/car, not if-let: a #f miss must read as falsy (if-let treats
  ;; #f as truthy on current sema).
  (let ((hits (filter (lambda (d) (= (string/lower (:display-name d))
                                     (string/lower name)))
                      provider-descriptors)))
    (if (null? hits) #f (car hits))))

(defun provider-env-keys ()
  "Every provider's API-key env var, in descriptor order — for the boot and
   usage 'no key' messages."
  (map :env-key provider-descriptors))

;; The providers/models offered by the /model autocomplete, derived from the
;; descriptor table. Purely a picker list — any model id typed by hand still
;; works, and a config's own :models replaces this wholesale.
(define default-models
  (map (lambda (d) (provider (:display-name d) (:models d))) provider-descriptors))

(define default-config
  {:model              "claude-opus-5" ;; default model; "" = auto-detect from API keys
   :effort             ""        ;; reasoning effort; "" = provider default (see /effort)
   :max-turns          50
   :tool-preview-lines 5         ;; result lines shown under a tool call in the TUI
   :models             default-models
   :mcp-servers        '()
   :commands           '()
   :hooks              '()        ;; lifecycle hooks (list of (hook event fn))
   :keys               {}})       ;; action → key overrides (e.g. {:mcp "ctrl-p"})

(defun model-entries (cfg)
  "Flatten the config's :models provider groups into {:id :label :provider}
   entries, in declaration order."
  (apply append
    (map (lambda (p)
           (map (lambda (m) (assoc m :provider (:name p))) (get p :models '())))
         (get cfg :models '()))))

(defun model-entry (cfg model-id)
  "The :models entry whose :id is MODEL-ID, or #f."
  (let ((hits (filter #(= (:id %) model-id) (model-entries cfg))))
    (if (null? hits) #f (car hits))))

(defun model-effort (cfg model-id)
  "The per-model :effort default declared on CFG's entry for MODEL-ID, or \"\"."
  ;; plain `let`/`if`, not `if-let`: model-entry returns #f when absent, and on
  ;; current sema `if-let` treats #f as truthy — it would bind e=#f and crash in
  ;; `get`. `if` reads #f as falsy correctly.
  (let ((e (model-entry cfg model-id)))
    (if e (get e :effort "") "")))

(defun model-provider-name (cfg model-id)
  "The llm provider id that owns MODEL-ID per CFG's :models — the provider
   group's display name, lowercased (sema's registry names are lowercase:
   anthropic, openai, …) — or #f when MODEL-ID isn't in the config."
  (let ((e (model-entry cfg model-id)))
    (if e (string/lower (:provider e)) #f)))

(defun mcp-server (name opts)
  "A server record. OPTS is the mcp/connect map plus the app key :autostart."
  {:name      name
   :opts      (dissoc opts :autostart)
   :autostart (get opts :autostart #f)
   :transport (if (get opts :url #f) "http" "stdio")})

(defun command (name spec)
  "A command record. SPEC carries :desc and one of :run (argv) / :do (fn) /
   :shell, plus optional :key (e.g. \"ctrl-t\") to bind a keyboard shortcut and
   :keep-input #t to leave the prompt intact when run from the palette (for a
   handler that reads/rewrites *input* itself)."
  (assoc spec :name name))

(defun hook (event handler)
  "A lifecycle-hook record for the config's :hooks list: subscribe HANDLER (a fn
   of one context map) to EVENT — see hooks.sema for the event catalog."
  {:event event :handler handler})

(defun coder-config (m)
  "Assemble the config value, filling any omitted key from the defaults."
  (merge default-config m))

(defun known-config-keys ()
  "The recognized top-level config keys — everything default-config declares."
  (keys default-config))

(defun unknown-config-keys (cfg)
  "Top-level keys in CFG that aren't recognized (from default-config). merge
   keeps a typo'd key like :max-turn, so this recovers it for a warning
   instead of letting it vanish silently."
  (filter (lambda (k) (not (member k (known-config-keys)))) (keys cfg)))

(defun config-sequence? (v) (or (list? v) (vector? v)))

(defun config-records? (v)
  (and (config-sequence? v) (every map? v)))

(defun config-validation-error (cfg)
  "The first invalid config field, or nil when CFG is safe to reconcile."
  (cond
    ((not (map? cfg)) "configure! expects a config map")
    ((not (string? (get cfg :model ""))) ":model must be a string")
    ((not (string? (get cfg :effort ""))) ":effort must be a string")
    ((let ((n (get cfg :max-turns 50))) (not (and (integer? n) (> n 0))))
      ":max-turns must be a positive integer")
    ((let ((n (get cfg :tool-preview-lines 5))) (not (and (integer? n) (> n 0))))
      ":tool-preview-lines must be a positive integer")
    ((not (config-records? (get cfg :models '())))
      ":models must be a list or vector of provider maps")
    ((not (config-records? (get cfg :mcp-servers '())))
      ":mcp-servers must be a list or vector of server maps")
    ((not (config-records? (get cfg :commands '())))
      ":commands must be a list or vector of command maps")
    ((not (config-records? (get cfg :hooks '())))
      ":hooks must be a list or vector of hook maps")
    ((not (map? (get cfg :keys {}))) ":keys must be a map")
    (else nil)))

;; ── Single sink + pure loader ────────────────────────────────────
;; configure! writes a scratch cell, not the active config, so a load that
;; throws mid-file can't leave the app's config half-applied.

(define *pending-config* #f)

(defun configure! (cfg) (set! *pending-config* cfg) cfg)

(defun load-config (path)
  "Read + evaluate PATH, capture the configured value. Pure: {:ok cfg} | {:error e}."
  (set! *pending-config* #f)
  (try
    (begin
      (load path)
      (if *pending-config*
        (let ((invalid (config-validation-error *pending-config*)))
          (if invalid {:error invalid} {:ok *pending-config*}))
        {:error "init.sema did not call (configure! …)"}))
    (catch e {:error e})))

;; ── Generate the init.sema :models block from the descriptor table, so the
;; first-run template can't drift from default-models. ──
(defun provider-block-source (d)
  "Rendered `(provider …)` source for descriptor D and its models, the ids
   padded so the labels line up."
  (let ((w (foldl max 0 (map (lambda (m) (string/length (format "~s" (:id m))))
                             (:models d)))))
    (string/append
      "       (provider " (format "~s" (:display-name d)) "\n"
      "         (list\n"
      (string/join
        (map (lambda (m)
               (string/append "           (model "
                              (string/pad-right (format "~s" (:id m)) w)
                              " " (format "~s" (:label m)) ")"))
             (:models d))
        "\n")
      "))")))

(defun default-models-source ()
  "The `(list (provider …) …)` source spliced into default-init-source; loading
   it reproduces default-models exactly."
  (string/append
    "(list\n"
    (string/join (map provider-block-source provider-descriptors) "\n")
    ")"))

;; ── First-run default (annotated so humans + agents copy correct syntax) ──
;; The :models block is generated from provider-descriptors, so it can't drift.

(define default-init-source
  (string/append
";; init.sema — Sema Coder config (Lisp data, hot-reloaded on save).
;; Edit in any editor; declarations are values the app reconciles to.

(configure!
  (coder-config
    {:model      \"claude-opus-5\"    ; default model; \"\" = auto-detect from API keys
     :effort     \"\"                 ; none/minimal/low/medium/high/xhigh; \"\" = provider default
     :max-turns  50
     :tool-preview-lines 5          ; result lines shown under each tool call

     ;; ── Models offered by the /model autocomplete, grouped by provider. ──
     ;; Only a picker list — any model id typed by hand still works. A model
     ;; may carry per-model defaults, e.g.
     ;;   (model \"gpt-5.6-sol\" \"GPT-5.6 Sol\" {:effort \"high\"})
     :models
     "
    (default-models-source)
"

     ;; ── MCP servers — manage in the /mcp modal (⌃O). Each is a value. ──
     :mcp-servers
     (list
       ;; Sema's own MCP server: gives the agent eval + docs into Sema itself.
       ;; On by default — comment out this line to disable it.
       (mcp-server \"sema\" {:command \"sema\" :args [\"mcp\" \"--include\" \"eval,docs,docs_search\"]
                           :autostart #t})
       ;; (mcp-server \"fs\"    {:command \"npx\" :args [\"-y\" \"@modelcontextprotocol/server-filesystem\" \".\"]})
       ;; (mcp-server \"asana\" {:url \"https://mcp.asana.com/mcp\"})   ; OAuth when you connect
       )   ; only add servers you trust — they run real commands / reach real services

     ;; ── Slash commands — argv (no shell), or a Lisp handler. ──
     ;; :key gives a command a keyboard shortcut, e.g. ctrl-t → /test.
     :commands
     (list
       (command \"test\" {:desc \"run tests\" :run [\"make\" \"test\"] :key \"ctrl-t\"})
       ;; (command \"log\" {:desc \"git log\" :run [\"git\" \"log\" \"--oneline\" \"-n\" :args]})
       )

     ;; ── Keybindings — rebind any action, or bind a key to a command name. ──
     ;; actions: :mcp :resume :palette :quit :interrupt :clear-line :line-start :line-end :repaint
     :keys {}   ;; e.g. {:mcp \"ctrl-p\" :test \"ctrl-t\"}

     ;; ── Hooks — observe the turn lifecycle. Uncomment to add handlers; each
     ;; takes a context map and its return is ignored. Events + their ctx:
     ;;   :session-start {:cwd}          :pre-turn {:input :messages}
     ;;   :pre-tool-call {:tool :args}   :post-turn {:input :result}
     ;;   :on-error {:input :error}
     ;; :hooks (list (hook :pre-tool-call (lambda (ctx) ...)))
     }))
"))

(defun ensure-config! ()
  "Write the annotated default init.sema if none exists. Returns the path."
  (let ((path (config-path)))
    (unless (file/exists? path)
      (file/mkdir (config-dir))
      (file/write path default-init-source))
    path))
