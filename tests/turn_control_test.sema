(load "harness.sema")
(load "../src/tui.sema")

(defun reset-controller! ()
  (set! *messages* '())
  (set! *input-queue* '())
  (set! *queue-paused* #f)
  (set! *busy* #f)
  (set! *turn* #f)
  (set! *interrupt* #f)
  (set! *interrupt-mode* #f)
  (set! *active-turn-id* #f)
  (set! *active-turn-input* "")
  (set! *turn-started-at* #f)
  (set! *turn-partial* #f)
  (reset-round-text!)
  (set! *active-tool-block-index* #f)
  (reset-type-buffer!)
  (set! *session-id* #f)
  (set! *queue-seq* 0)
  (set! *turn-seq* 0)
  (set! *background-task-notices* '())
  (clear-turn-events!)
  (clear-transcript!)
  (prompt-clear!))

;; Streaming callbacks append O(1) chunks. The display and cancellation history
;; still observe the exact ordered text after one materialization pass.
(reset-controller!)
(add-block! {:kind :assistant :text ""})
(on-text-cb "one")
(on-text-cb " two")
(check "stream deltas remain chunked before a frame" *type-buffer* "")
(check "streamed character count does not require concatenation"
  (:streamed-chars (turn-controller-state)) 7)
(flush-type-buffer!)
(check "chunked stream reveals in arrival order" (:text (block-at 0)) "one two")
(check "round history materializes in arrival order" (round-text-value!) "one two")

(defun fake-result (messages input response)
  {:response response
   :messages (append messages
               (list {:role "user" :content input}
                     {:role "assistant" :content response}))})

(defun position-of (items target)
  (let loop ((rest items) (i 0))
    (cond ((null? rest) #f)
          ((= (car rest) target) i)
          (else (loop (cdr rest) (+ i 1))))))

(let ((event (normalize-turn-event
               {:seq 8 :event "turn-interrupted" :mode "steer" :source "queue"})))
  (check "restored event name is normalized" (:event event) :turn-interrupted)
  (check "restored event mode is normalized" (:mode event) :steer)
  (check "restored event source is normalized" (:source event) :queue))

(clear-turn-events!)
(for-each (lambda (i) (record-turn-event! :sample {:value i}))
          (range 0 (+ EVENT-LOG-LIMIT 1)))
(check-true "event log is bounded"
  (< (length (turn-events)) EVENT-LOG-LIMIT))
(check "event sequence stays monotonic after compaction"
  (:seq (last-message (turn-events))) (+ EVENT-LOG-LIMIT 1))
(new-session!)
(check "fresh session clears prior event log" (turn-events) '())
(set! *session-id* #f)

;; Stable queue ids, FIFO follow-ups, steer priority, editing, and
;; removal are all deterministic without an LLM.
(reset-controller!)
(let ((a (enqueue-input! "one" "follow-up"))
      (b (enqueue-input! "two" "follow-up"))
      (s (enqueue-input! "steer" "steer" "turn-x")))
  (check "steer precedes follow-ups"
    (map :text (queued-messages)) (list "steer" "one" "two"))
  (check-true "stable queue id" (string/starts-with? (:id a) "queue-"))
  (check-true "queued message can be edited" (update-queued-input! (:id b) "two edited"))
  (check "edit keeps queue order"
    (map :text (queued-messages)) (list "steer" "one" "two edited"))
  (check-true "queued message can be removed" (remove-queued-input! (:id a)))
  (check-false "removing missing id reports false" (remove-queued-input! "missing"))
  (check "remove keeps remaining order"
    (map :text (queued-messages)) (list "steer" "two edited"))
  (check "steer records compare-and-cancel target" (:target-turn-id s) "turn-x")
  (set! *tui-active* #t)
  (parameterize ((current-emit (lambda (kind text) nil)))
    (dispatch-command
      (parse-command f"/queue edit ${(:id b)} edited through command")
      (tui-state)))
  (check "queue edit command updates by stable id"
    (:text (nth (queued-messages) 1)) "edited through command")
  (set! *queue-paused* #t)
  (let ((values (map :value (command-completions "queue" (tui-state)))))
    (check-true "queue completions offer resume only while paused"
      (member "resume" values))
    (check-true "queue completions include the exact drop id"
      (member f"drop ${(:id s)}" values))
    (check-true "queue completions include an editable id"
      (member f"edit ${(:id b)} " values)))
  (set! *tui-active* #f))

(reset-controller!)
(set! *busy* #t)
(set! *turn-started-at* 1000)
(parameterize ((current-ui-clock (lambda () 13450)))
  (check-contains "busy status shows elapsed turn time"
    (term/strip (status-line)) "evaluating · 12.4s"))

(reset-controller!)
(set! *background-tasks*
  (map (lambda (record)
         {:id (nth record 0) :command "test" :status (nth record 1)
          :started-at 1000 :updated-at 2200 :finished-at 2250
          :exit-code (nth record 2)
          :stdout-capture (empty-background-capture)
          :stderr-capture (empty-background-capture)})
       (list (list "task-done" :completed 0)
             (list "task-failed" :failed 7)
             (list "task-stopped" :stopped -1))))
(handle-background-task-change!)
(handle-background-task-change!)
(let ((notices (filter #(string/contains? (get % :text "") "/debug tasks")
                       (transcript-blocks))))
  (check "each settled background task is announced once" (length notices) 3)
  (check "background completion uses success styling" (:kind (nth notices 0)) :ok)
  (check "background failure uses error styling" (:kind (nth notices 1)) :error)
  (check "background stop uses warning styling" (:kind (nth notices 2)) :warn))
(set! *background-tasks* '())

(set! *queue-paused* #t)
(clear-input-queue!)
(check-false "clearing queue also clears paused state" *queue-paused*)

(let ((entry (enqueue-input! "remove me" "follow-up")))
  (set! *queue-paused* #t)
  (remove-queued-input! (:id entry))
  (check-false "removing the last follow-up clears paused state" *queue-paused*))

;; Prompt keys use the active-turn controls without taking Tab away from slash
;; completion. Enter remains a normal submit key while idle.
(reset-controller!)
(set! *busy* #t)
(set! *active-turn-id* "turn-keys")
(prompt-set! "run after this")
(handle-named {:kind :key :name :tab})
(check "Tab queues an ordinary follow-up while busy"
  (map (lambda (entry) (list (:text entry) (:mode entry))) (queued-messages))
  (list (list "run after this" "follow-up")))
(check "Tab clears a queued prompt" (prompt-text) "")
(check-false "Tab does not request interruption" *interrupt*)

(reset-controller!)
(set! *busy* #t)
(set! *active-turn-id* "turn-keys")
(prompt-set! "change direction")
(handle-named {:kind :key :name :enter})
(check "Enter queues a targeted steer while busy"
  (map (lambda (entry)
         (list (:text entry) (:mode entry) (:target-turn-id entry)))
       (queued-messages))
  (list (list "change direction" "steer" "turn-keys")))
(check "Enter clears a steering prompt" (prompt-text) "")
(check-true "Enter requests interruption" *interrupt*)
(check "Enter records steer interruption mode" *interrupt-mode* :steer)

(reset-controller!)
(set! *busy* #t)
(set! *active-turn-id* "turn-palette")
(prompt-set! "/mod")
(handle-named {:kind :key :name :tab})
(check "palette completion keeps priority over busy Tab" (prompt-text) "/model ")
(check "palette completion does not queue model input" (queued-messages) '())
(check-false "palette completion does not request interruption" *interrupt*)

;; Tool completion targets the block created by its start event, even when a
;; warning or error block is appended while the tool runs.
(reset-controller!)
(parameterize ((current-turn-render (lambda () nil)))
  (on-tool-cb {:event "start" :tool "bash" :args {:command "sleep 1"}})
  (add-block! {:kind :error :text "unrelated queue warning"})
  (check "active tool phase survives a later block"
    (:phase (turn-controller-state)) :tool)
  (on-tool-cb {:event "end" :tool "bash" :args {:command "sleep 1"}
               :duration-ms 8 :result "done" :error #f}))
(check "tool end settles its indexed block"
  (:state (block-at 0)) :done)
(check "tool end keeps its result on the indexed block"
  (:result (block-at 0)) "done")
(check "intervening error block is not overwritten"
  (:text (block-at 1)) "unrelated queue warning")

;; Cancellation is compare-and-set by turn id and idempotent for retries.
(reset-controller!)
(set! *busy* #t)
(set! *active-turn-id* "turn-live")
(set! *turn* (async (async/sleep 5000)))
(check-false "cancel rejects stale turn id" (request-interrupt-for! "turn-old" :stop))
(check-true "cancel accepts active turn id" (request-interrupt-for! "turn-live" :stop))
(check-true "duplicate cancel is idempotently accepted" (request-interrupt-for! "turn-live" :stop))
(check "duplicate cancel emits one request event"
  (length (filter #(= (:event %) :cancel-requested) (turn-events))) 1)

;; The real interrupt path stops a foreground bash process before cancelling
;; its agent task. A delayed descendant marker proves that no process survives.
(reset-controller!)
(define foreground-interrupt-marker
  (path/join (sys/temp-dir)
    (string-append "sema-coder-turn-interrupt-" (number->string (sys/pid)))))
(when (file/exists? foreground-interrupt-marker) (file/delete foreground-interrupt-marker))
(let* ((inner (string-append "sleep 0.3; echo leaked > "
                (shell/quote foreground-interrupt-marker)))
       (command (string-append "sh -c " (shell/quote inner) " & wait"))
       (work (async (run-in-workspace-timed command 3000))))
  (set! *busy* #t)
  (set! *active-turn-id* "turn-foreground")
  (set! *turn* work)
  (async/sleep 40)
  (check-true "interrupt accepts a turn running foreground bash"
    (request-interrupt-for! "turn-foreground" :stop))
  (try (await work) (catch cancelled nil))
  (async/sleep 450)
  (check-false "turn interrupt kills foreground descendants"
    (file/exists? foreground-interrupt-marker)))

;; A normal completion automatically drains ordinary queued work exactly once.
(reset-controller!)
(define normal-calls '())
(define late-text-callback #f)
(define normal-runner
  (lambda (agent input messages on-tool on-text on-partial effort)
    (set! normal-calls (append normal-calls (list input)))
    (set! late-text-callback on-text)
    (when (= input "first") (enqueue-input! "second" "follow-up"))
    (on-text f"reply ${input}")
    (fake-result messages input f"reply ${input}")))

(parameterize ((current-turn-runner normal-runner)
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (run-agent-turn! "first"))

(check "normal turn drains FIFO queue" normal-calls (list "first" "second"))
(check "queue is empty after drain" (queued-messages) '())
(check "two turns persisted in model history" (length *messages*) 4)
(check "two terminal completion events"
  (length (filter #(= (:event %) :turn-completed) (turn-events))) 2)
(let ((before *round-text*)
      (before-chars *round-text-chars*))
  (late-text-callback "late delta")
  (check "late delta cannot mutate terminal turn" *round-text* before)
  (check "late delta cannot change the streamed count" *round-text-chars* before-chars))

;; The terminal event must be part of the same durable write as the messages.
(reset-controller!)
(define event-tmp
  (path/join (sys/temp-dir) (string/append "sema-coder-turn-events-" (number->string (sys/pid)))))
(set! *session-id* "terminal-event")
(set! *session-created* 1700000000)
(parameterize ((config-dir-override event-tmp)
               (current-turn-runner
                 (lambda (agent input messages on-tool on-text on-partial effort)
                   (fake-result messages input "done")))
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (run-agent-turn! "persist event")
  (let* ((saved (load-session "terminal-event"))
         (events (get (:meta saved) :events '())))
    (check "terminal event is saved with completed messages"
      (:event (nth events (- (length events) 1))) "turn-completed"))
  (file/delete (session-path "terminal-event")))

;; Ctrl-C interruption keeps the active input + streaming partial, pauses
;; ordinary queued work, records a terminal marker, and ignores a stale id.
(reset-controller!)
(define stopped-calls '())
(define stopped-runner
  (lambda (agent input messages on-tool on-text on-partial effort)
    (set! stopped-calls (append stopped-calls (list input)))
    (enqueue-input! "later" "follow-up")
    (on-text "partial")
    (on-partial {:messages (append messages (list {:role "user" :content input}))})
    (check-false "stale cancel cannot affect active turn"
      (request-interrupt-for! "stale-turn" :stop))
    (check-true "matching cancel accepted"
      (request-interrupt-for! *active-turn-id* :stop))
    (async/sleep 5000)))

(parameterize ((current-turn-runner stopped-runner)
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (run-agent-turn! "stop me"))

(check "ordinary queue does not run after interrupt" stopped-calls (list "stop me"))
(check-true "interrupt pauses ordinary queue" *queue-paused*)
(check "queued follow-up remains" (map :text (queued-messages)) (list "later"))
(check "partial assistant retained" (:content (nth *messages* 1)) "partial")
(check "durable control marker retained" (:event (last-message *messages*)) "turn-interrupted")
(check "interrupted turn has one terminal event"
  (length (filter #(= (:event %) :turn-interrupted) (turn-events))) 1)

(define resumed-calls '())
(define resumed-runner
  (lambda (agent input messages on-tool on-text on-partial effort)
    (set! resumed-calls (append resumed-calls (list input)))
    (fake-result messages input "resumed answer")))
(parameterize ((current-turn-runner resumed-runner)
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (resume-input-queue!))
(check "explicit resume drains paused queue" resumed-calls (list "later"))
(check-false "queue is unpaused after explicit resume" *queue-paused*)

;; An interruption with no ordinary follow-up reports the interruption but does
;; not create a paused queue state or claim that queued work was paused.
(reset-controller!)
(define empty-stop-runner
  (lambda (agent input messages on-tool on-text on-partial effort)
    (request-interrupt-for! *active-turn-id* :stop)
    (async/sleep 5000)))
(parameterize ((current-turn-runner empty-stop-runner)
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (run-agent-turn! "stop without queue"))
(check-false "empty interruption does not pause the queue" *queue-paused*)
(check "empty interruption leaves no queued input" (queued-messages) '())
(let ((blocks (:blocks (transcript-debug-state))))
  (check "empty interruption still reports its terminal state"
    (:text (last blocks)) "turn interrupted")
  (check-false "empty interruption does not show a queue-paused warning"
    (any #(string/contains? (get % :text "") "queued follow-ups are paused") blocks)))

;; Interrupt-and-send persists the steer before cancellation, waits for the
;; interrupted terminal state, then starts the replacement. Ordinary queued work
;; remains paused after the replacement completes.
(reset-controller!)
(define steer-calls '())
(define steer-runner
  (lambda (agent input messages on-tool on-text on-partial effort)
    (set! steer-calls (append steer-calls (list input)))
    (if (= input "original")
      (begin
        (enqueue-input! "ordinary" "follow-up")
        (on-text "old partial")
        (on-partial {:messages (append messages (list {:role "user" :content input}))})
        (prompt-set! "replacement")
        (on-steer-enter)
        (async/sleep 5000))
      (fake-result messages input "new answer"))))

(parameterize ((current-turn-runner steer-runner)
               (current-turn-pump (lambda (turn) nil))
               (current-turn-render (lambda () nil)))
  (run-agent-turn! "original"))

(check "steer starts only after cancelled turn" steer-calls (list "original" "replacement"))
(check "steer leaves ordinary queue paused" (map :text (queued-messages)) (list "ordinary"))
(check-true "queue stays paused after replacement" *queue-paused*)
(let ((events (map :event (turn-events))))
  (check-true "cancel request precedes interrupted terminal"
    (< (or (position-of events :cancel-requested) 999)
       (or (position-of events :turn-interrupted) -1)))
  (check-true "interrupted terminal precedes replacement start"
    (< (or (position-of events :turn-interrupted) 999)
       ;; There are two starts; find the last by reversing.
       (- (length events) 1 (or (position-of (reverse events) :turn-started) 999)))))

(let ((snapshot (turn-controller-state)))
  (check "inspectable controller is idle" (:status snapshot) :idle)
  (check "inspectable controller reports idle phase" (:phase snapshot) :idle)
  (check "inspectable controller exposes queue" (map :text (:queue snapshot)) (list "ordinary"))
  (check-true "inspectable controller exposes event log" (> (length (:events snapshot)) 0)))

(define debug-status-output "")
(set! *tui-active* #t)
(parameterize ((current-emit
                 (lambda (kind text)
                   (when (= kind :raw) (set! debug-status-output text)))))
  (dispatch-command (parse-command "/debug status") (tui-state)))
(set! *tui-active* #f)
(check-contains "TUI debug status is multiline JSON" debug-status-output "\n  \"events\"")

(define debug-tasks-output "")
(parameterize ((current-emit
                 (lambda (kind text)
                   (when (= kind :raw) (set! debug-tasks-output text)))))
  (dispatch-command (parse-command "/debug tasks") (tui-state)))
(let ((snapshot (json/decode debug-tasks-output)))
  (check "debug tasks is valid indented JSON" (:count snapshot) 0)
  (check-contains "debug tasks JSON spans lines" debug-tasks-output "\n  \"limit\""))

(add-block! {:kind :info :text "diagnostic transcript marker"})
(define debug-transcript-output "")
(set! *tui-active* #t)
(parameterize ((current-emit
                 (lambda (kind text)
                   (when (= kind :raw) (set! debug-transcript-output text)))))
  (dispatch-command (parse-command "/debug transcript") (tui-state)))
(set! *tui-active* #f)
(let ((snapshot (json/decode debug-transcript-output)))
  (check-true "debug transcript includes blocks" (> (:block-count snapshot) 0))
  (check "debug transcript exposes cache renders"
    (get (:cache snapshot) :block-renders -1)
    (transcript-render-count))
  (check "debug transcript includes exact last block text"
    (:text (last (:blocks snapshot)))
    "diagnostic transcript marker"))

(done)
