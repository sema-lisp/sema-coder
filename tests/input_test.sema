(load "harness.sema")
(load "../src/tui.sema")

;; Prompt-input editing: forward-delete, delete-word-back, and word motion.
;; Handlers are driven directly on the *input*/*cursor* globals.

(defun set-input! (s c) (set! *input* s) (set! *cursor* c))

;; ── forward-delete (the Delete key): removes the char AT the cursor ──
(set-input! "abcd" 1)
(forward-delete!)
(check "forward-delete removes char at cursor" *input* "acd")
(check "forward-delete keeps cursor" *cursor* 1)
(set-input! "abc" 3)
(forward-delete!)
(check "forward-delete at end is a no-op" *input* "abc")

;; ── delete-word-backward (Option+Delete) ──
(set-input! "foo bar" 7)
(delete-word-backward!)
(check "delete-word-back removes the word" *input* "foo ")
(check "delete-word-back moves cursor to boundary" *cursor* 4)

;; ── word motion ──
(set-input! "foo bar" 7)
(word-left!)
(check "word-left jumps to word start" *cursor* 4)
(set-input! "foo bar" 0)
(word-right!)
(check "word-right jumps past the word" *cursor* 3)

;; ── dispatch: :delete arm, and modified vs plain arrows ──
(set-input! "abc" 0)
(handle-named {:kind :key :name :delete})
(check "handle-named :delete forward-deletes" *input* "bc")

(set-input! "foo bar" 7)
(handle-named {:kind :key :name :left :mods (list :alt)})
(check "Option+Left = word motion" *cursor* 4)

(set-input! "foo bar" 7)
(handle-named {:kind :key :name :left})
(check "plain Left = single char" *cursor* 6)

(set-input! "foo bar" 7)
(handle-alt {:kind :alt :char "\u007f"})
(check "Option+Delete (alt DEL) deletes word" *input* "foo ")

;; ── Prompt input API (the extension surface: read + edit the prompt) ──
(set-input! "hello world" 5)
(check "prompt-text reads the input"   (prompt-text) "hello world")
(check "prompt-cursor reads the caret" (prompt-cursor) 5)

;; prompt-insert! splices at the caret and advances past it (multi-char)
(prompt-insert! " there")
(check "prompt-insert! splices at caret" *input* "hello there world")
(check "prompt-insert! advances caret"   *cursor* 11)

;; prompt-set! replaces the whole prompt, caret to end
(prompt-set! "/todos")
(check "prompt-set! replaces text"  *input* "/todos")
(check "prompt-set! caret to end"   *cursor* 6)

;; prompt-clear! empties it
(prompt-clear!)
(check "prompt-clear! empties"      *input* "")
(check "prompt-clear! caret to 0"   *cursor* 0)

;; Bracketed paste inserts one event into the prompt. Newlines stay data and
;; terminal controls are removed instead of being executed or dispatched.
(set-input! "before after" 6)
(handle-key {:kind :paste :text " one\ntwo "})
(check "paste inserts multiline text at the caret" *input* "before one\ntwo  after")
(check "paste advances the caret by all inserted codepoints" *cursor* 15)
(set-input! "" 0)
(handle-key {:kind :paste :text (string-append "safe" "\x1b;[2J" "owned")})
(check "paste strips terminal control sequences" *input* "safeowned")

(done)

;; ── kill / yank ──
(set-input! "foo bar" 7)
(kill-word-backward!)
(check "kill-word removes the word" *input* "foo ")
(yank!)
(check "yank restores it" *input* "foo bar")
(set-input! "abc def" 4)
(kill-to-line-start!)
(check "kill-to-line-start keeps the tail" *input* "def")
(check "kill-to-line-start caret at 0" *cursor* 0)
(set-input! "one\ntwo three" 9)
(kill-to-line-start!)
(check "kill-to-line-start stops at the line break" *input* "one\nthree")

;; ── multi-line prompt: vertical motion, then history past the edges ──
(set! *history* '())
(set-input! "ab\ncdef" 6)
(check "cursor line index" (cursor-line-index) 1)
(handle-named {:kind :key :name :up})
(check "Up moves to the line above, same column" *cursor* 2)
(handle-named {:kind :key :name :down})
(check "Down returns to the line below" *cursor* 5)
(check "prompt height follows the lines" (prompt-height) 2)
(check "prompt view has one row per line" (length (:rows (prompt-view))) 2)
(check "caret row is the second row" (:caret-row (prompt-view)) 1)
(handle-named {:kind :key :name :enter :mods (list :shift)})
(check "Shift-Enter inserts a line break" *input* "ab\ncd\nef")

;; ── history ──
(set! *history* '())
(history-push! "first")
(history-push! "second")
(history-push! "second")
(check "history dedups the newest entry" (length *history*) 2)
(set-input! "draft" 5)
(handle-named {:kind :key :name :up})
(check "Up shows the newest entry" *input* "second")
(handle-named {:kind :key :name :up})
(check "Up again shows the older entry" *input* "first")
(handle-named {:kind :key :name :up})
(check "Up past the oldest stays" *input* "first")
(handle-named {:kind :key :name :down})
(handle-named {:kind :key :name :down})
(check "Down past the newest restores the draft" *input* "draft")
(let ((before *scroll*))
  (handle-named {:kind :key :name :down})
  (check "Down never scrolls" *scroll* before))
