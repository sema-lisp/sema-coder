(load "harness.sema")
(load "../src/session.sema")

(define tmp (path/join (sys/temp-dir) (string/append "sema-coder-sess-" (number->string (sys/pid)))))

(define msgs
  (list
    {:role "user" :content "add 21 and 21"}
    {:role "assistant" :content ""
     :tool-calls (list {:id "c1" :name "calc" :arguments {:a 21 :b 21}})}
    {:role "tool" :content "42" :tool-call-id "c1" :tool-name "calc"}
    {:role "assistant" :content "21 plus 21 is 42."}))

(parameterize ((config-dir-override tmp))
  (save-session! "sess1" 1700000000 "claude-opus-4-8" "high" msgs)

  (let ((rows (list-sessions)))
    (check "one session listed" (length rows) 1)
    (let ((m (car rows)))
      (check "title from first user msg" (:title m) "add 21 and 21")
      (check "model preserved"           (:model m) "claude-opus-4-8")
      (check "effort preserved"          (:effort m) "high")
      (check "created preserved"         (:created m) 1700000000)
      (check "message count"             (:count m) 4)))

  (let ((loaded (load-session "sess1")))
    (check "loaded message count" (length (:messages loaded)) 4)
    (let ((a (nth (:messages loaded) 1)))
      (check "assistant role"     (:role a) "assistant")
      (check "tool-call name"     (:name (car (:tool-calls a))) "calc")
      (check "tool-call arg a"    (:a (:arguments (car (:tool-calls a)))) 21))
    (let ((tm (nth (:messages loaded) 2)))
      (check "tool result content" (:content tm) "42")
      (check "tool-call-id linked" (:tool-call-id tm) "c1")))

  (let ((renamed (rename-session! "sess1" "  Custom\nname  ")))
    (check "rename returns normalized title" (:title renamed) "Custom name")
    (check "rename records an explicit title"
      (:custom-title (:meta (load-session "sess1"))) "Custom name"))
  (save-session! "sess1" 1700000000 "claude-opus-4-8" "high" msgs
    {:custom-title "Custom name"})
  (check "later saves preserve a custom title"
    (:title (:meta (load-session "sess1"))) "Custom name")

  ;; Queue metadata persists even without conversation messages, so a crash or
  ;; resume cannot silently discard future work.
  (define queued (list {:id "q-1" :text "next" :mode "follow-up"}))
  (define events (list {:seq 1 :event "message-queued"}))
  (save-session! "queued" 1700000002 "m" "" '()
                 {:queue queued :queue-paused #t :events events})
  (let ((loaded (load-session "queued")))
    (check "queued input persists" (get (:meta loaded) :queue '()) queued)
    (check-true "paused queue persists" (get (:meta loaded) :queue-paused #f))
    (check "controller events persist" (get (:meta loaded) :events '()) events))

  ;; empty message list writes nothing
  (save-session! "empty" 1700000001 "m" "" '())
  (check "empty not persisted" (length (list-sessions)) 2)

  ;; The filename is authoritative. A hand-edited metadata id cannot redirect
  ;; restore/rename/delete actions to another session.
  (let* ((dest (session-path "filename-id"))
         (forged (assoc (:meta (load-session "sess1")) :id "sess1")))
    (write-session! "filename-id" forged msgs)
    (check "session listing derives id from the filename"
      (:id (session-meta-of dest)) "filename-id")
    (file/delete dest))

  ;; A typed /resume id cannot escape the sessions directory.
  (check-true "plain session id accepted" (valid-session-id? "1700-42_test.v1"))
  (check "slash in session id rejected" (valid-session-id? "../outside") #f)
  (check "backslash in session id rejected" (valid-session-id? "..\\outside") #f)
  (check-true "session path traversal throws"
    (try (begin (session-path "../outside") #f) (catch e #t)))

  (save-session! "delete-me" 1700000003 "m" "" msgs)
  (check-true "delete removes an existing session" (delete-session! "delete-me"))
  (check-false "delete reports a missing session" (delete-session! "delete-me"))
  (check-throws "rename rejects an empty title"
    (lambda () (rename-session! "sess1" "  ")))

  (file/delete (session-path "sess1"))
  (file/delete (session-path "queued")))

(done)
