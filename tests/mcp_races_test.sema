(load "harness.sema")
(load "../src/mcp.sema")

(define native-connect mcp-connect-timed)
(define handles '())
;; Delay only after acquiring a real handle: a deterministic scheduling window
;; covers the same suspension as a remote handshake, without timing the server.
(define ready #f)
(define release #f)
(set! mcp-connect-timed
  (lambda (opts)
    (let ((h (native-connect opts)))
      (set! handles (append handles (list h)))
      (channel/send ready #t)
      (channel/recv release)
      h)))

(defun prepare-race! ()
  (mcp-reset!)
  (set! handles '())
  (set! ready (channel/new 1))
  (set! release (channel/new 1))
  (reconcile-servers!
    (list (mcp-server "race" {:command "sema" :args ["mcp" "--include" "eval"]}))))

(defun closed-handle? (h)
  (try (begin (mcp/tools->sema h) #f) (catch e #t)))

(prepare-race!)
(define first (async (mcp-connect! "race")))
(channel/recv ready)
(mcp-disconnect! "race")
(channel/send release #t)
(await first)
(check "disconnect wins over a late connect" (:status (mcp-get "race")) :idle)
(check "disconnect leaves no published handle" (:handle (mcp-get "race")) #f)
(check-true "superseded connect closes its acquired handle" (closed-handle? (car handles)))

(prepare-race!)
(define removed (async (mcp-connect! "race")))
(channel/recv ready)
(reconcile-servers! '())
(channel/send release #t)
(await removed)
(check "removed record stays removed" (mcp-get "race") #f)
(check-true "removed record's late handle is closed" (closed-handle? (car handles)))

(prepare-race!)
(define changed (async (mcp-connect! "race")))
(channel/recv ready)
(reconcile-servers! (list (mcp-server "race" {:command "different"})))
(channel/send release #t)
(await changed)
(check "changed endpoint stays idle" (:status (mcp-get "race")) :idle)
(check "changed endpoint has no old tools" (:tools (mcp-get "race")) '())
(check-true "changed endpoint closes late old handle" (closed-handle? (car handles)))

(prepare-race!)
(define retry-old (async (mcp-connect! "race")))
(channel/recv ready)
(check "duplicate connect shares the pending attempt" (mcp-connect! "race") :connecting)
(check "duplicate connect acquires no second handle" (length handles) 1)
(mcp-disconnect! "race")
(set! mcp-connect-timed native-connect)
(check "retry after disconnect can connect" (mcp-connect! "race") :connected)
(define retry-handle (:handle (mcp-get "race")))
(channel/send release #t)
(check "old attempt reports superseded" (await retry-old) :superseded)
(check "late completion preserves retry handle" (:handle (mcp-get "race")) retry-handle)
(check-true "old attempt handle closes after retry" (closed-handle? (car handles)))
(check-false "retry handle remains usable" (closed-handle? retry-handle))

;; A late failure must not overwrite a successful retry either.
(mcp-reset!)
(reconcile-servers!
  (list (mcp-server "race" {:command "sema" :args ["mcp" "--include" "eval"]})))
(set! mcp-connect-timed
  (lambda (opts)
    (channel/send ready #t)
    (channel/recv release)
    (error "old handshake failed")))
(define failed-old (async (mcp-connect! "race")))
(channel/recv ready)
(mcp-disconnect! "race")
(set! mcp-connect-timed native-connect)
(mcp-connect! "race")
(define successful-retry (:handle (mcp-get "race")))
(channel/send release #t)
(check "late failure reports superseded" (await failed-old) :superseded)
(check "late failure cannot fail a connected retry" (:status (mcp-get "race")) :connected)
(check "late failure preserves retry handle" (:handle (mcp-get "race")) successful-retry)

(set! mcp-connect-timed native-connect)
(mcp-reset!)
(done)
