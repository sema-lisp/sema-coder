#!/usr/bin/env sema
;; Opt-in live-provider smoke test. This is intentionally not an *_test.sema
;; file: CI and the default suite never spend API quota.
;;
;;   sema tests/live_interrupt_smoke.sema -- failure  # deterministic, no API
;;   SEMA_CODER_LIVE=1 sema tests/live_interrupt_smoke.sema -- complete
;;   SEMA_CODER_LIVE=1 sema tests/live_interrupt_smoke.sema -- foreground
;;   SEMA_CODER_LIVE=1 sema tests/live_interrupt_smoke.sema -- steer
;;   SEMA_CODER_LIVE=1 sema tests/live_interrupt_smoke.sema -- background

(load "../src/tui.sema")

(define scenario
  (let ((args (sys/args)))
    (cond ((member "failure" args) "failure")
          ((member "complete" args) "complete")
          ((member "background" args) "background")
          ((or (member "foreground" args) (member "tool" args)) "foreground")
          ((member "steer" args) "steer")
          ((member "text" args) "foreground")
          (else "complete"))))

(define live? (not (= scenario "failure")))

(when (and live? (not (= (env "SEMA_CODER_LIVE") "1")))
  (io/println-error "set SEMA_CODER_LIVE=1 to allow live model calls")
  (exit 2))

(when (and live? (not (llm/auto-configure)))
  (io/println-error "no configured LLM provider")
  (exit 2))

(set! *cwd* (sys/cwd))
(set! *config* default-config)
(let ((requested (env "SEMA_CODER_LIVE_MODEL")))
  (set! *model*
    (if (and requested (not (= requested ""))) requested (:model default-config))))
(set! *agent* (if live? (create-agent *cwd* *model* *config*) #f))
(set! *messages* '())
(set! *input-queue* '())
(set! *queue-paused* #f)
(set! *session-id* #f)
(clear-turn-events!)
(clear-transcript!)

(define prompt
  (cond
    ((= scenario "failure") "exercise deterministic provider failure")
    ((= scenario "complete")
      "Reply only with the word completed. Do not call tools.")
    ((= scenario "foreground")
      "For a cancellation smoke test, call the bash tool exactly once with the command `sleep 5; echo live-smoke`. Do not use another tool. Then report the output.")
    ((= scenario "background")
      "Start `sleep 0.2; echo background-live-smoke` with bash in background mode. Then use task-output with wait enabled, inspect its terminal status and output, and report both. Do not run the command in the foreground.")
    (else
      "Write a detailed 1500-word technical explanation of cooperative task cancellation. Start the explanation immediately and do not use tools.")))

(define replacement "Reply only with the word recovered.")

(defun live-cancel-pump (turn)
  (let loop ((ticks 0))
    (when (async/pending? turn)
      (let ((tool-running?
              (let ((b (last-block)))
                (and b (= (get b :kind :none) :tool)
                     (= (get b :state :none) :running)))))
        (cond
          ((and (= scenario "foreground") tool-running?) (request-interrupt!))
          ((and (= scenario "steer") (= *active-turn-input* prompt) (>= ticks 50))
            (prompt-set! replacement)
            (on-steer-enter))
          ((and (= scenario "foreground") (>= ticks 250))
            (request-interrupt!))
          ((and (= scenario "steer") (>= ticks 750)) (request-interrupt!))
          ((>= ticks 1500) (request-interrupt!))
          (else (async/sleep 20) (loop (+ ticks 1))))))))

(parameterize ((current-turn-runner
                 (if (= scenario "failure")
                   (lambda (agent input messages on-tool on-text on-partial effort)
                     (error "deterministic provider failure"))
                   run-turn-streaming))
               (current-turn-pump live-cancel-pump)
               (current-turn-render (lambda () nil)))
  (run-agent-turn! prompt))

(define control-count
  (length (filter #(= (get % :kind "") "agent-control") *messages*)))
(define cancelled-tool-count
  (length (filter #(and (= (get % :kind :none) :tool)
                        (= (get % :state :none) :cancelled))
                  (transcript-blocks))))

(define smoke-result
  (let* ((events (map :event (turn-events)))
         (background-completed?
           (any #(and (= (get % :status :unknown) :completed)
                      (string/contains?
                        (background-capture-text (:stdout-capture %))
                        "background-live-smoke"))
                *background-tasks*))
         (ok?
           (match scenario
             ("failure" (if (member :turn-failed events) #t #f))
             ("complete" (if (member :turn-completed events) #t #f))
             ("foreground" (and (member :turn-interrupted events)
                                 (> cancelled-tool-count 0)))
             ("steer" (if (and (member :turn-interrupted events)
                                (member :turn-completed events)) #t #f))
             ("background" background-completed?)
             (_ #f))))
  {:ok ok?
   :scenario scenario
   :state (turn-controller-state)
   :roles (map #(get % :role "") *messages*)
   :control-count control-count
   :cancelled-tool-count cancelled-tool-count
   :background-tasks (map background-task-output-state *background-tasks*)
   :partial-assistant-chars
     (foldl (lambda (n m)
              (if (= (get m :role "") "assistant")
                (+ n (string/length (get m :content ""))) n))
            0 *messages*)}))

(stop-all-background-tasks!)
(println (json/encode smoke-result))
(exit (if (:ok smoke-result) 0 1))
