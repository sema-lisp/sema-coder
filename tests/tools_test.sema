(load "harness.sema")
(load "../src/tools.sema")

(define tools-test-root
  (path/join (sys/temp-dir) (string-append "sema-coder-tools " (number->string (sys/pid)))))
(shell "rm" "-rf" tools-test-root)
(set-workspace-root! tools-test-root)
(file/mkdir tools-test-root)
(file/write (path/join tools-test-root "cwd-marker") "ok")

;; ── apply-edit: the pure core of edit-file (unique match, or replace_all) ──
(check "apply-edit empty old" (:error (apply-edit "abc" "" "x" #f)) "old_string must not be empty.")
(check-contains "apply-edit not found" (:error (apply-edit "abc" "z" "x" #f)) "not found")
(check "apply-edit unique replace" (apply-edit "a b a" "b" "B" #f) {:text "a B a" :count 1})
(check-contains "apply-edit multi is an error without replace_all"
                (:error (apply-edit "a a a" "a" "b" #f)) "matches 3 times")
(check "apply-edit replace_all replaces every match" (apply-edit "a a a" "a" "b" #t) {:text "b b b" :count 3})

;; ── search-argv: grep/rg argv construction with ignore_case + glob ──
(check "rg plain argv"
       (search-argv :rg "foo" "." #f #f)
       (list "rg" "--line-number" "--max-count" "10" "--no-heading" "--" "foo" "."))
(check "rg ignore-case + glob"
       (search-argv :rg "foo" "." #t "*.rs")
       (list "rg" "--line-number" "--max-count" "10" "--no-heading" "-i" "-g" "*.rs" "--" "foo" "."))
(check "grep fallback include glob"
       (search-argv :grep "foo" "." #f "*.sema")
       (list "grep" "-rn" "-m" "10" "--include=*.sema" "--" "foo" "."))

;; ── workspace execution: cwd is an option, not a quoted `cd &&` prefix ──
(check "shell command runs in workspace with spaces"
       (:exit-code (run-in-workspace "test -f cwd-marker")) 0)
(check "argv command runs directly in workspace"
       (:exit-code (run-argv-in-workspace ["sh" "-c" "test -f cwd-marker"])) 0)
(check "argv preserves shell metacharacters as data"
       (string/trim (:stdout (run-argv-in-workspace ["echo" "a; b"]))) "a; b")

;; ── run-in-workspace-timed: bash timeout (spawns a real child) ──
(defun proc-handle-closed? (handle)
  "A handle is closed when the registry no longer serves it. Sema 1.35 keeps a
   handle whose proc/wait was cancelled in flight (the only process-group kill)
   and refuses every later op on it; that terminal state counts as closed too."
  (try
    (begin (proc/running? handle) #f)
    (catch e
      (let ((msg (get e :message (str e))))
        (or (string/contains? msg "no such handle")
            (string/contains? msg "no longer usable"))))))

(define handle-sentinel (proc/spawn ["sh" "-c" "true"]))
(proc/wait handle-sentinel)
(proc/close handle-sentinel)
(define normal-foreground-handle (+ handle-sentinel 1))
(let ((r (run-in-workspace-timed "echo hi; exit 2" 3000)))
  (check "timed: exit code passthrough" (:exit-code r) 2)
  (check "timed: not timed out"         (:timed-out r) #f)
  (check-contains "timed: captured stdout" (:stdout r) "hi")
  (check-true "completed foreground process handle is closed"
    (proc-handle-closed? normal-foreground-handle)))
(define timed-out-foreground-handle (+ normal-foreground-handle 1))
(let ((r (run-in-workspace-timed "echo start; sleep 3" 120)))
  (check "timed: slow command is killed"  (:timed-out r) #t)
  (check-contains "timed: partial stdout before kill" (:stdout r) "start")
  (check-true "timed-out foreground process handle is closed"
    (proc-handle-closed? timed-out-foreground-handle)))

;; The interruption coordinator must stop a foreground command and its
;; descendants before cancelling the Sema task. The delayed marker observes the
;; OS process, independent of the tool's internal bookkeeping.
(define cancelled-marker (path/join tools-test-root "cancelled-foreground-leaked"))
(when (file/exists? cancelled-marker) (file/delete cancelled-marker))
(let* ((inner (string-append "sleep 0.3; echo leaked > " (shell/quote cancelled-marker)))
       (cmd (string-append "sh -c " (shell/quote inner) " & wait"))
       (work (async (run-in-workspace-timed cmd 3000))))
  (async/sleep 40)
  (stop-active-foreground-processes!)
  (async/cancel work)
  (try (await work) (catch cancelled nil))
  (async/sleep 450)
  (check "cancelled foreground descendants cannot keep running"
    (file/exists? cancelled-marker) #f)
  (check "foreground cancellation clears process ownership"
    *foreground-process-handles* '()))

;; A timeout must kill grandchildren too. The old proc/kill path killed only
;; the outer sh; this nested shell survived and wrote the marker afterwards.
(define leak-marker (path/join tools-test-root "descendant-leaked"))
(when (file/exists? leak-marker) (file/delete leak-marker))
(let* ((inner (string-append "sleep 0.4; echo leaked > " (shell/quote leak-marker)))
       (cmd   (string-append "sh -c " (shell/quote inner) " & wait"))
       (r     (run-in-workspace-timed cmd 60)))
  (check "tree timeout reported" (:timed-out r) #t)
  (async/sleep 600)
  (check "timed out descendant cannot keep running" (file/exists? leak-marker) #f))

;; Keep draining after the capture budget is full so a noisy process cannot
;; block on its pipe or grow the Sema heap without bound.
(let ((r (run-in-workspace-timed "yes x | head -c 120000" 3000)))
  (check-true "stdout capture is bounded"
    (<= (string/length (:stdout r)) MAX-CAPTURE-CHARS)))

;; ── Background bash tasks: lifecycle, output, cancellation independence ──
(reset-background-tasks!)

(defun invoke-json (tool-def args)
  (json/decode (tool/invoke tool-def args)))

(define launched
  (invoke-json bash
    {:command "printf start; sleep 0.08; printf done" :background #t}))
(define launched-id (:task-id launched))
(check "background bash returns a short process-local task id"
  launched-id "task-1")
(check "new background task starts running" (:status launched) "running")

(define completed
  (invoke-json task-output {:task_id launched-id :wait #t :timeout 2}))
(check "task-output waits for completion" (:status completed) "completed")
(check "completed task exposes exit code" (:exit-code completed) 0)
(check-contains "task-output retains stdout head" (:stdout completed) "start")
(check-contains "task-output retains stdout tail" (:stdout completed) "done")
(check-true "completed task exposes its finish time"
  (number? (:finished-at completed)))
(check-true "completed task exposes its last update time"
  (number? (:updated-at completed)))
(check "task-list includes the completed task"
  (:task-id (car (invoke-json task-list {}))) launched-id)

;; Frontend redraw failures are not part of process ownership. A notification
;; callback may fail without turning a successful launch into a tool error.
(define notify-launch
  (parameterize ((current-background-task-change
                   (lambda () (error "redraw failed"))))
    (invoke-json bash {:command "echo callback-safe" :background #t})))
(define notify-result
  (invoke-json task-output
    {:task_id (:task-id notify-launch) :wait #t :timeout 2}))
(check "redraw callback failure does not break background launch"
  (:status notify-result) "completed")
(check-contains "redraw callback failure preserves process output"
  (:stdout notify-result) "callback-safe")

(define failed-launch
  (invoke-json bash {:command "echo bad >&2; exit 3" :background #t}))
(define failed
  (invoke-json task-output
    {:task_id (:task-id failed-launch) :wait #t :timeout 2}))
(check "nonzero background exit is failed" (:status failed) "failed")
(check "failed background task keeps exit code" (:exit-code failed) 3)
(check-contains "failed background task retains stderr" (:stderr failed) "bad")

;; stdin is closed at spawn, so an accidental prompt cannot hang invisibly.
(define eof-launch
  (invoke-json bash
    {:command "if read answer; then echo unexpected; else echo eof; fi"
     :background #t}))
(define eof-result
  (invoke-json task-output
    {:task_id (:task-id eof-launch) :wait #t :timeout 2}))
(check "background stdin is closed" (:status eof-result) "completed")
(check-contains "closed stdin reaches EOF branch" (:stdout eof-result) "eof")

;; Cancelling the task which launched bash does not own or cancel the process.
(start-background-monitor!)
(define survivor-id #f)
(define launching-parent
  (async
    (set! survivor-id
      (:task-id
        (invoke-json bash
          {:command "sleep 0.08; echo survived" :background #t})))
    (async/sleep 5000)))
(let loop ()
  (unless survivor-id (async/sleep 1) (loop)))
(async/cancel launching-parent)
(try (await launching-parent) (catch cancelled nil))
(let loop ((ticks 0))
  (when (and (< ticks 200)
             (background-task-active? (background-task-by-id survivor-id)))
    (async/sleep 10)
    (loop (+ ticks 1))))
(define monitor-survivor (background-task-by-id survivor-id))
(check "TUI-owned monitor survives launching-turn cancellation"
  (:status monitor-survivor) :completed)
(define survived
  (invoke-json task-output {:task_id survivor-id :wait #t :timeout 2}))
(check "background process survives launching-turn cancellation"
  (:status survived) "completed")
(check-contains "surviving process output remains inspectable"
  (:stdout survived) "survived")
(stop-background-monitor!)

;; Retention is bounded but keeps both ends for useful startup and failure logs.
(define noisy-launch
  (invoke-json bash
    {:command "printf HEAD; yes x | head -c 70000; printf TAIL"
     :background #t}))
(define noisy
  (invoke-json task-output
    {:task_id (:task-id noisy-launch) :wait #t :timeout 2}))
(check-true "background stdout reports truncation" (:stdout-truncated noisy))
(check-true "background retained stdout is bounded"
  (<= (string/length (:stdout noisy)) (+ BACKGROUND-STREAM-CHARS 100)))
(check-contains "bounded background output keeps its head" (:stdout noisy) "HEAD")
(check-contains "bounded background output keeps its tail" (:stdout noisy) "TAIL")

;; A self-backgrounding shell leader must not leave a descendant holding the
;; output pipes and the task in :settling forever.
(define daemon-leak-marker (path/join tools-test-root "daemon-descendant-leaked"))
(when (file/exists? daemon-leak-marker) (file/delete daemon-leak-marker))
(define daemon-inner
  (string-append "sleep 0.5; echo leaked > " (shell/quote daemon-leak-marker)))
(define daemonized
  (invoke-json bash
    {:command (string-append "sh -c " (shell/quote daemon-inner) " &")
     :background #t}))
(define daemonized-result
  (invoke-json task-output
    {:task_id (:task-id daemonized) :wait #t :timeout 2}))
(check "self-backgrounding command reaches a terminal state"
  (:status daemonized-result) "completed")
(check-contains "self-backgrounding cleanup is reported"
  (:cleanup-warning daemonized-result) "remaining process group stopped")
(async/sleep 600)
(check "self-backgrounding descendant is terminated"
  (file/exists? daemon-leak-marker) #f)

;; Explicit stop uses the same process-group termination path as foreground
;; timeout, so a child shell cannot outlive its registered task.
(define background-leak-marker (path/join tools-test-root "background-descendant-leaked"))
(when (file/exists? background-leak-marker) (file/delete background-leak-marker))
(define background-inner
  (string-append "sleep 0.4; echo leaked > " (shell/quote background-leak-marker)))
(define stoppable
  (invoke-json bash
    {:command (string-append "sh -c " (shell/quote background-inner) " & wait")
     :background #t}))
(async/sleep 30)
(define stopped (invoke-json task-stop {:task_id (:task-id stoppable)}))
(check "task-stop records a terminal stopped state" (:status stopped) "stopped")
(async/sleep 600)
(check "stopped background descendants cannot keep running"
  (file/exists? background-leak-marker) #f)

(check "task-stop reports an unknown task without raising"
  (tool/invoke task-stop {:task_id "task-missing"})
  "Error: No background task task-missing")

;; If cancellation interrupts task-stop after it records :stopping, a retry
;; must still terminate and settle the process.
(define retry-stop-launch
  (invoke-json bash {:command "sleep 5" :background #t}))
(define retry-stop-id (:task-id retry-stop-launch))
(update-background-task!
  (assoc (background-task-by-id retry-stop-id) :status :stopping))
(define retry-stopped (invoke-json task-stop {:task_id retry-stop-id}))
(check "task-stop retries a process left in stopping state"
  (:status retry-stopped) "stopped")

(reset-background-tasks!)
(check "background reset clears task records" (background-task-summaries) '())

(shell "rm" "-rf" tools-test-root)
(done)
