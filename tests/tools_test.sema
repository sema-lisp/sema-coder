(load "harness.sema")
(load "../src/tools.sema")

(define tools-test-root
  (path/join (sys/temp-dir)
    (string-append "sema-coder-tools " (number->string (sys/pid)))))
(shell "rm" "-rf" tools-test-root)
(set-workspace-root! tools-test-root)
(file/mkdir tools-test-root)
(file/write (path/join tools-test-root "cwd-marker") "ok")

;; ── read-file: size and binary guards run before the whole file is read ──
(file/write (path/join tools-test-root "small.txt") "one\ntwo\n")
(check-contains "read-file numbers lines" (tool/invoke read-file {:path "small.txt" :offset nil :limit nil}) "two")
(check-contains "read-file injects omitted paging defaults"
  (tool/invoke read-file {:path "small.txt"}) "two")
(check "read-file offset defaults to one"
  (get (get (tool/parameters read-file) :offset) :default) 1)
