(load "harness.sema")
(load "../src/config.sema")

;; Point the config dir at a temp location, generate the default, and confirm
;; it round-trips through the pure loader with the sema autostart server present.
(define d "/tmp/sc-cfg-default-test")
(shell "rm" "-rf" d)

(parameterize ((config-dir-override d))
  (check "path under override" (config-path) (path/join d "init.sema"))
  (check-true "not there yet" (not (file/exists? (config-path))))
  (ensure-config!)
  (check-true "file created" (file/exists? (config-path)))
  ;; idempotent: a second call doesn't clobber
  (ensure-config!)
  (let ((r (load-config (config-path))))
    (check-true "default loads ok" (:ok r))
    (check "generated config uses the default model"
           (:model (:ok r)) "claude-opus-5")
    (let ((srv (car (:mcp-servers (:ok r)))))
      (check "first server is sema" (:name srv) "sema")
      (check "sema autostarts" (:autostart srv) #t)
      (check "sema is stdio" (:transport srv) "stdio"))
    (check "has the test command" (:name (car (:commands (:ok r)))) "test")
    (check "has the model picker list"
           (length (model-entries (:ok r))) (length (model-entries default-config)))
    (check "first picker entry"
           (car (model-entries (:ok r)))
           (car (model-entries default-config)))
    ;; The template is generated from provider-descriptors, so it can never
    ;; drift from the catalog: every descriptor model appears, and the loaded
    ;; :models round-trips to exactly default-models.
    (check "generated init carries the default models verbatim"
           (:models (:ok r)) default-models)
    (for-each
      (lambda (m)
        (check-contains f"template has ${(:id m)}"
          default-init-source f"(model \"${(:id m)}\""))
      (model-entries default-config))))

(done)
